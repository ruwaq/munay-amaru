---
import type { Locale } from '../utils/i18n';
interface Props { activePage?: string; locale?: Locale; }
const { activePage = 'home', locale = 'es' } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';

const tabs = [
  {
    id: 'home', href: prefix + '/',
    label: locale === 'es' ? 'Diario' : 'Journal',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15z"/></svg>`,
  },
  {
    id: 'shop', href: prefix + '/tienda/',
    label: locale === 'es' ? 'Trazos' : 'Marks',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
  },
  {
    id: 'sounds', href: prefix + '/sonidos/',
    label: locale === 'es' ? 'Sonidos' : 'Sounds',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12h2M6 8v8M10 5v14M14 8v8M18 10v4M22 12h-2"/></svg>`,
  },
  {
    id: 'words', href: prefix + '/palabras/',
    label: locale === 'es' ? 'Palabras' : 'Words',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
  },
  {
    id: 'gazes', href: prefix + '/miradas/',
    label: locale === 'es' ? 'Rutas' : 'Routes',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/></svg>`,
  },
];
---

<nav class="bottom-dock" aria-label={locale === 'es' ? 'Navegación del diario' : 'Journal navigation'}>
  <div class="dock-inner">
    {tabs.map((tab) => (
      <a
        href={tab.href}
        class={`dock-tab${activePage === tab.id ? ' active' : ''}`}
        aria-current={activePage === tab.id ? 'page' : undefined}
        aria-label={tab.label}
      >
        <div class="dock-icon-wrapper">
          <Fragment set:html={tab.icon} />
        </div>
        <span>{tab.label}</span>
      </a>
    ))}
  </div>
</nav>
