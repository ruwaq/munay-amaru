---
// MyceliumNetwork.astro: Red Micorrízica Real & Hifas Vivas del Suelo Forestal
---

<div class="mycelium-canvas-wrap" aria-hidden="true">
  <svg class="mycelium-svg" id="mycelium-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
    <defs>
      <!-- Gradiente orgánico para hifas micorrízicas y raicillas -->
      <linearGradient id="hypha-nature-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="hsl(38, 50%, 42%)" stop-opacity="0.38" />
        <stop offset="50%" stop-color="hsl(40, 75%, 52%)" stop-opacity="0.82" />
        <stop offset="100%" stop-color="hsl(32, 45%, 36%)" stop-opacity="0.38" />
      </linearGradient>

      <!-- Gradiente para el flujo de savia y esporas microscópicas -->
      <radialGradient id="spore-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="hsl(44, 90%, 82%)" stop-opacity="0.95" />
        <stop offset="40%" stop-color="hsl(39, 85%, 55%)" stop-opacity="0.8" />
        <stop offset="100%" stop-color="hsl(30, 60%, 40%)" stop-opacity="0" />
      </radialGradient>

      <!-- Filtro de difusión suave orgánica (humedad y suelo) -->
      <filter id="nature-glow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="2.2" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Estrato Subterráneo: Raíces de Bosque & Hifas Profundas -->
    <g id="soil-roots-bg" class="soil-roots-bg"></g>

    <!-- Red de Hifas Micorrízicas Vivas entre las Obras -->
    <g id="hyphae-group" class="hyphae-group"></g>

    <!-- Nodos de Germinación y Raicillas (Brotes de Vida) -->
    <g id="root-buds-group" class="root-buds-group"></g>

    <!-- Esporas Microscópicas & Flujo de Savia Vegetal -->
    <g id="spores-group" class="spores-group"></g>
  </svg>
</div>

<style>
  .mycelium-canvas-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .mycelium-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Raíces de bosque profundas en el humus */
  :global(.ambient-root) {
    fill: none;
    stroke: hsla(28, 30%, 35%, 0.3);
    stroke-width: 1.8px;
    stroke-linecap: round;
    stroke-dasharray: 6, 4;
  }

  :global(.ambient-root-primary) {
    fill: none;
    stroke: hsla(30, 35%, 40%, 0.4);
    stroke-width: 2.4px;
    stroke-linecap: round;
  }

  /* Hifas de micelio orgánicas conectando las paredes de tierra */
  :global(.hypha-path) {
    fill: none;
    stroke: hsla(38, 70%, 52%, 0.55);
    stroke-width: 2.2px;
    stroke-linecap: round;
    transition: stroke 0.4s ease, stroke-width 0.4s ease, opacity 0.4s ease, filter 0.4s ease;
  }

  :global(.hypha-path.is-active) {
    stroke: hsl(42, 95%, 62%) !important;
    stroke-width: 3.6px !important;
    opacity: 1 !important;
    filter: drop-shadow(0 0 9px hsla(42, 90%, 55%, 0.85)) !important;
  }

  /* Nodos de raíz y brotes de tierra */
  :global(.root-bud) {
    fill: hsl(38, 80%, 52%);
    stroke: hsl(28, 40%, 20%);
    stroke-width: 1.5px;
    transition: transform 0.35s ease, fill 0.35s ease;
  }

  :global(.root-bud.is-active) {
    fill: hsl(44, 100%, 65%);
    transform: scale(1.4);
    filter: drop-shadow(0 0 8px hsla(42, 95%, 55%, 0.85));
  }

  /* Partículas de savia y esporas */
  :global(.spore-particle) {
    pointer-events: none;
    filter: url(#nature-glow);
  }

  @media (prefers-color-scheme: dark) {
    :global(.ambient-root) {
      stroke: hsla(38, 35%, 50%, 0.22);
    }
    :global(.hypha-path) {
      stroke: hsla(40, 60%, 52%, 0.48);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.spore-particle) {
      display: none !important;
    }
  }
</style>

<script>
  // Mapa ecológico de interconexiones entre las 12 creaciones en la tierra
  const ecologicalConnections: [string, string][] = [
    // Conexiones desde el Núcleo (Munay: Ayni & Fuego Central)
    ['spec-001', 'spec-002'], // Munay <-> I Am a Tree (Raíz & Savia)
    ['spec-001', 'spec-003'], // Munay <-> Los Guardianes (Bosque vivo)
    ['spec-001', 'spec-004'], // Munay <-> Illari (Aguas subterráneas)
    ['spec-001', 'spec-006'], // Munay <-> The Heart's Medicine (Corazón y gratitud)
    ['spec-001', 'spec-008'], // Munay <-> Pachamamita (Andes y agua del barranco)
    ['spec-001', 'spec-012'], // Munay <-> Manifiesto (Principios vitales)

    // Red de Raíces & Semillas (Tierra, Cuentos y Pensamiento)
    ['spec-004', 'spec-003'], // Illari <-> Los Guardianes (Psique <-> Bosque)
    ['spec-003', 'spec-007'], // Los Guardianes <-> Seeds (Hifas <-> Semillas)
    ['spec-007', 'spec-010'], // Seeds <-> Oda a la Digestión (Suelo <-> Vientre)
    ['spec-010', 'spec-012'], // Oda a la Digestión <-> Manifiesto (Humor <-> Ética)
    ['spec-004', 'spec-012'], // Illari <-> Manifiesto (Luz lúcida)

    // Red de Ramas & Frutos Sonoros (Voz, Charango y Medicina en 432 Hz)
    ['spec-002', 'spec-005'], // I Am a Tree <-> Il Canto Senza Paura (Árbol <-> Canto)
    ['spec-005', 'spec-006'], // Il Canto Senza Paura <-> The Heart's Medicine
    ['spec-006', 'spec-008'], // The Heart's Medicine <-> Pachamamita
    ['spec-008', 'spec-009'], // Pachamamita <-> Pipene & Gailene (Agua <-> Micorriza)
    ['spec-009', 'spec-011'], // Pipene & Gailene <-> El Amigo de Cuatro Patas
    ['spec-002', 'spec-009'], // I Am a Tree <-> Pipene & Gailene (Árbol <-> Hongo)

    // Puentes de Simbiosis Ecológica
    ['spec-007', 'spec-009'], // Seeds <-> Pipene & Gailene (Semilla <-> Micorriza)
    ['spec-010', 'spec-011'], // Oda a la Digestión <-> El Amigo (Tierra <-> Animal)
    ['spec-004', 'spec-005'], // Illari <-> Il Canto Senza Paura (Búsqueda <-> Fuerza)
  ];

  function drawLivingMycelium() {
    const svg = document.getElementById('mycelium-svg') as SVGSVGElement | null;
    const rootsBgGroup = document.getElementById('soil-roots-bg');
    const hyphaeGroup = document.getElementById('hyphae-group');
    const rootBudsGroup = document.getElementById('root-buds-group');
    const sporesGroup = document.getElementById('spores-group');
    if (!svg || !rootsBgGroup || !hyphaeGroup || !rootBudsGroup || !sporesGroup) return;

    // Limpiar trazos previos
    rootsBgGroup.innerHTML = '';
    hyphaeGroup.innerHTML = '';
    rootBudsGroup.innerHTML = '';
    sporesGroup.innerHTML = '';

    const svgRect = svg.getBoundingClientRect();
    if (svgRect.width === 0 || svgRect.height === 0) return;

    const w = svgRect.width;
    const h = svgRect.height;
    const midX = w / 2;

    // 1. Dibujar raicillas orgánicas de fondo del sotobosque
    const ambientRoots = [
      // Raíz nodriza principal desde el suelo
      `M ${midX - 80} 30 C ${midX - 120} ${h * 0.25}, ${w * 0.15} ${h * 0.45}, ${w * 0.1} ${h * 0.75} S ${w * 0.2} ${h * 0.95}, ${midX - 40} ${h - 30}`,
      `M ${midX + 80} 30 C ${midX + 130} ${h * 0.28}, ${w * 0.85} ${h * 0.48}, ${w * 0.9} ${h * 0.72} S ${w * 0.8} ${h * 0.92}, ${midX + 40} ${h - 30}`,
      // Raicillas capilares intermedias
      `M ${w * 0.15} ${h * 0.2} Q ${w * 0.35} ${h * 0.28}, ${midX} ${h * 0.35} T ${w * 0.85} ${h * 0.38}`,
      `M ${w * 0.25} ${h * 0.65} Q ${midX} ${h * 0.6}, ${w * 0.75} ${h * 0.68}`,
      `M ${midX} ${h * 0.1} Q ${midX + 25} ${h * 0.5}, ${midX} ${h - 20}`,
    ];

    ambientRoots.forEach((d, i) => {
      const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.setAttribute('d', d);
      p.setAttribute('class', i < 2 ? 'ambient-root-primary' : 'ambient-root');
      rootsBgGroup.appendChild(p);
    });

    // 2. Trazar Hifas Micorrízicas Orgánicas entre Obras
    const renderedBuds = new Set<string>();

    ecologicalConnections.forEach(([idA, idB], index) => {
      const elA = document.getElementById(idA);
      const elB = document.getElementById(idB);
      if (!elA || !elB) return;

      const rectA = elA.getBoundingClientRect();
      const rectB = elB.getBoundingClientRect();

      // Coordenadas absolutas dentro del SVG
      const x1 = rectA.left + rectA.width / 2 - svgRect.left;
      const y1 = rectA.top + rectA.height / 2 - svgRect.top;
      const x2 = rectB.left + rectB.width / 2 - svgRect.left;
      const y2 = rectB.top + rectB.height / 2 - svgRect.top;

      const dx = x2 - x1;
      const dy = y2 - y1;
      const dist = Math.hypot(dx, dy);
      if (dist < 10) return;

      // Curvatura biológica natural (hifas que crecen sorteando partículas en la tierra)
      const sign = (index % 2 === 0 ? 1 : -1);
      const curveAmount = Math.min(65, dist * 0.18) * sign;

      const cx1 = x1 + dx * 0.33 - (dy / dist) * curveAmount;
      const cy1 = y1 + dy * 0.33 + (dx / dist) * curveAmount;
      const cx2 = x1 + dx * 0.67 + (dy / dist) * (curveAmount * 0.6);
      const cy2 = y1 + dy * 0.67 - (dx / dist) * (curveAmount * 0.6);

      const pathData = `M ${x1} ${y1} C ${cx1} ${cy1}, ${cx2} ${cy2}, ${x2} ${y2}`;
      const pathId = `hypha-path-${idA}-${idB}`;

      // Elemento <path> de la hifa
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('id', pathId);
      path.setAttribute('d', pathData);
      path.setAttribute('class', 'hypha-path');
      path.setAttribute('data-connects', `${idA},${idB}`);
      hyphaeGroup.appendChild(path);

      // Nodos de germinación en los puntos de contacto
      if (!renderedBuds.has(idA)) {
        const budA = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        budA.setAttribute('cx', String(x1));
        budA.setAttribute('cy', String(y1));
        budA.setAttribute('r', '4');
        budA.setAttribute('class', 'root-bud');
        budA.setAttribute('data-node', idA);
        rootBudsGroup.appendChild(budA);
        renderedBuds.add(idA);
      }
      if (!renderedBuds.has(idB)) {
        const budB = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        budB.setAttribute('cx', String(x2));
        budB.setAttribute('cy', String(y2));
        budB.setAttribute('r', '4');
        budB.setAttribute('class', 'root-bud');
        budB.setAttribute('data-node', idB);
        rootBudsGroup.appendChild(budB);
        renderedBuds.add(idB);
      }

      // 3. Esporas y Nutrientes viajando lentamente por la Hifa
      const spore = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      spore.setAttribute('r', '3.5');
      spore.setAttribute('fill', 'url(#spore-glow)');
      spore.setAttribute('class', 'spore-particle');
      spore.setAttribute('data-path', pathId);

      // Ritmo biológico de bosque (4.8s a 7.8s)
      const biologicalSpeeds = [4.8, 5.7, 6.9, 5.2, 6.3, 7.8, 4.9, 6.0];
      const speed = biologicalSpeeds[index % biologicalSpeeds.length];
      const delay = ((index * 0.7) % 4.0).toFixed(1);

      const animMotion = document.createElementNS('http://www.w3.org/2000/svg', 'animateMotion');
      animMotion.setAttribute('dur', `${speed}s`);
      animMotion.setAttribute('repeatCount', 'indefinite');
      animMotion.setAttribute('begin', `${delay}s`);
      animMotion.setAttribute('rotate', 'auto');
      animMotion.setAttribute('calcMode', 'spline');
      animMotion.setAttribute('keyTimes', '0; 1');
      animMotion.setAttribute('keySplines', '0.42 0 0.28 1');

      const mpath = document.createElementNS('http://www.w3.org/2000/svg', 'mpath');
      mpath.setAttributeNS('http://www.w3.org/1999/xlink', 'href', `#${pathId}`);
      animMotion.appendChild(mpath);

      spore.appendChild(animMotion);
      sporesGroup.appendChild(spore);
    });
  }

  // Interacción biofílica al tocar o posar el cursor sobre una obra
  function setupMyceliumHover() {
    const cards = document.querySelectorAll('.specimen-card');
    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        const id = card.id;
        const connectedPaths = document.querySelectorAll(`.hypha-path[data-connects*="${id}"]`);
        connectedPaths.forEach((p) => p.classList.add('is-active'));

        // Resonancia en los brotes de raíz
        document.querySelectorAll(`.root-bud[data-node="${id}"]`).forEach((b) => b.classList.add('is-active'));

        // Resonancia en las obras hermanas conectadas por el micelio
        connectedPaths.forEach((p) => {
          const connects = p.getAttribute('data-connects')?.split(',') || [];
          connects.forEach((otherId) => {
            if (otherId !== id) {
              document.getElementById(otherId)?.classList.add('synergy-pulse');
              document.querySelectorAll(`.root-bud[data-node="${otherId}"]`).forEach((b) => b.classList.add('is-active'));
            }
          });
        });
      });

      card.addEventListener('mouseleave', () => {
        document.querySelectorAll('.hypha-path.is-active').forEach((p) => p.classList.remove('is-active'));
        document.querySelectorAll('.root-bud.is-active').forEach((b) => b.classList.remove('is-active'));
        document.querySelectorAll('.specimen-card.synergy-pulse').forEach((c) => c.classList.remove('synergy-pulse'));
      });
    });
  }

  function initMycelium() {
    drawLivingMycelium();
    setupMyceliumHover();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMycelium);
    window.addEventListener('load', initMycelium);
  } else {
    initMycelium();
  }

  if (document.fonts) {
    document.fonts.ready.then(() => {
      drawLivingMycelium();
    });
  }

  const container = document.getElementById('brain-stage');
  if (container && window.ResizeObserver) {
    const ro = new ResizeObserver(() => {
      drawLivingMycelium();
    });
    ro.observe(container);
  }

  let resizeTimer: number;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(drawLivingMycelium, 100);
  });
</script>
