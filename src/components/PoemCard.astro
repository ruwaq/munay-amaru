---
interface Props {
  title: string;
  excerpt?: string;
  slug: string;
  hasAudio?: boolean;
  date?: Date;
  tags?: string[];
  class?: string;
}

const { title, excerpt, slug, hasAudio = false, date, tags = [], class: extraClass = '' } = Astro.props;
const formattedDate = date ? date.toLocaleDateString('es-ES', {
  day: 'numeric', month: 'long', year: 'numeric'
}) : '';
---

<article class={`paper-card ${extraClass}`} style="display: flex; flex-direction: column; justify-content: space-between;">
  <div class="washi-tape top-right moss" aria-hidden="true"></div>
  <header style="margin-bottom: 12px;">
    <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
      {hasAudio && (
        <span style="color: var(--accent-rust); font-size: 0.9rem;" title="Incluye lectura en voz">
          ▶
        </span>
      )}
      <h3 style="font-family: var(--font-serif-title); font-size: 1.35rem; font-weight: 700; margin: 0;">
        <a href={slug} style="color: inherit; text-decoration: none;">{title}</a>
      </h3>
    </div>
    {formattedDate && (
      <time style="font-family: var(--font-typewriter); color: var(--ink-faint); font-size: 0.72rem; display: block; text-transform: uppercase;">
        {formattedDate}
      </time>
    )}
  </header>

  {excerpt && (
    <p style="font-style: italic; color: var(--ink-muted); line-height: 1.6; white-space: pre-line; font-size: 1.05rem; margin-bottom: 16px;">
      {excerpt}
    </p>
  )}

  <footer style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed var(--border-paper); padding-top: 10px;">
    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
      {tags.slice(0, 3).map(tag => (
        <span style="font-family: var(--font-mono-clean); font-size: 0.68rem; color: var(--ink-faint);">#{tag}</span>
      ))}
    </div>
    <a href={slug} style="font-family: var(--font-mono-clean); font-size: 0.75rem; text-transform: uppercase; color: var(--accent-rust);">
      Leer &rarr;
    </a>
  </footer>
</article>
