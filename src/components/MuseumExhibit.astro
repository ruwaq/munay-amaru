---
interface Props {
  invNumber: string;
  artist: string;
  title: string;
  year: string;
  medium: string;
  dimensions?: string;
  duration?: string;
  provenance?: string;
  concept: string;
  credits: string;
  imageSrc: string;
  imageAlt: string;
  linkUrl?: string;
  audioSrc?: string;
}

const {
  invNumber,
  artist,
  title,
  year,
  medium,
  dimensions,
  duration,
  provenance,
  concept,
  credits,
  imageSrc,
  imageAlt,
  linkUrl,
  audioSrc
} = Astro.props;
---

<article class="museum-vitrine">
  <!-- Enmarcado en Paspartú Flotante (Float Mount Frame) -->
  <div class="float-mount-frame">
    {linkUrl ? (
      <a href={linkUrl} target="_blank" rel="noopener noreferrer" style="display: block; text-decoration: none;">
        <img 
          src={imageSrc} 
          alt={imageAlt} 
          class="float-artwork" 
          loading="lazy" 
        />
      </a>
    ) : (
      <img 
        src={imageSrc} 
        alt={imageAlt} 
        class="float-artwork" 
        loading="lazy" 
      />
    )}
  </div>

  <!-- Cartela Curatorial de Museo (Museum Label) -->
  <div class="curatorial-label">
    <span class="inv-code">{invNumber}</span>
    <h3 class="artwork-artist">{artist}</h3>
    <div class="artwork-title-year"><em>{title}</em>, {year}</div>
    
    <div class="tech-specs">
      <div><strong>Técnica:</strong> {medium}</div>
      {dimensions && <div><strong>Dimensiones:</strong> {dimensions} {duration && `· Duración: ${duration}`}</div>}
      {provenance && <div><strong>Procedencia:</strong> {provenance}</div>}
    </div>

    <p class="curatorial-essay">
      {concept}
    </p>

    <div style="font-size: 0.8rem; color: var(--ink-faint); margin-bottom: 16px;">
      📎 {credits}
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      {linkUrl && (
        <a href={linkUrl} target="_blank" rel="noopener noreferrer" style="font-family: var(--font-body); font-size: 0.82rem; font-weight: 600; letter-spacing: 0.04em; color: var(--ink-primary); text-decoration: underline; text-underline-offset: 3px;">
          Explorar Obra en Colección &rarr;
        </a>
      )}
      {duration && (
        <span class="freq-badge">432 Hz CERTIFIED</span>
      )}
    </div>

    {audioSrc && (
      <div style="margin-top: 16px;">
        <audio controls src={audioSrc} style="width: 100%; height: 36px; filter: sepia(10%);"></audio>
      </div>
    )}
  </div>
</article>
