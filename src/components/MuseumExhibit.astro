---
interface Props {
  invNumber: string;
  artist: string;
  title: string;
  year: string;
  medium: string;
  dimensions?: string;
  duration?: string;
  provenance?: string;
  concept: string;
  credits: string;
  imageSrc: string;
  imageAlt: string;
  linkUrl?: string;
  audioSrc?: string;
}

const { invNumber, artist, title, year, medium, dimensions, duration, provenance, concept, credits, imageSrc, imageAlt, linkUrl, audioSrc } = Astro.props;

// Schema.org VisualArtwork para SEO semántico
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": title,
  "creator": { "@type": "Person", "name": artist },
  "dateCreated": year,
  "artMedium": medium,
  "description": concept,
  "image": imageSrc,
  "url": linkUrl || undefined,
});
---

<script type="application/ld+json" set:html={schema}></script>

<article class="museum-vitrine" itemscope itemtype="https://schema.org/VisualArtwork">
  <!-- Paspartú Flotante con spotlight virtual -->
  <div class="float-mount-frame">
    {linkUrl ? (
      <a href={linkUrl} target="_blank" rel="noopener noreferrer" style="display: block; text-decoration: none;" aria-label={`Ver obra ${title} de ${artist}`}>
        <img
          src={imageSrc}
          alt={imageAlt}
          class="float-artwork"
          loading="lazy"
          decoding="async"
          itemprop="image"
        />
      </a>
    ) : (
      <img
        src={imageSrc}
        alt={imageAlt}
        class="float-artwork"
        loading="lazy"
        decoding="async"
        itemprop="image"
      />
    )}
  </div>

  <!-- Cartela Curatorial de Museo (Museum Label) -->
  <div class="curatorial-label">
    <span class="inv-code">{invNumber}</span>
    <h3 class="artwork-artist" itemprop="creator">{artist}</h3>
    <div class="artwork-title-year">
      <em itemprop="name">{title}</em>, <span itemprop="dateCreated">{year}</span>
    </div>

    <div class="tech-specs">
      <div><strong>Técnica:</strong> <span itemprop="artMedium">{medium}</span></div>
      {dimensions && <div><strong>Dimensiones:</strong> {dimensions} {duration && `· Duración: ${duration}`}</div>}
      {provenance && <div><strong>Procedencia:</strong> {provenance}</div>}
    </div>

    <p class="curatorial-essay" itemprop="description">{concept}</p>

    <div style="font-size: 0.8rem; color: var(--ink-faint); margin-bottom: 16px; display: flex; align-items: flex-start; gap: 6px;">
      <span aria-hidden="true">&#128206;</span>
      <span>{credits}</span>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      {linkUrl && (
        <a
          href={linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="font-family: var(--font-body); font-size: 0.82rem; font-weight: 600; letter-spacing: 0.04em; color: var(--ink-primary); text-decoration: underline; text-underline-offset: 3px; min-height: 44px; display: inline-flex; align-items: center;"
          itemprop="url"
        >
          Explorar Obra en Colección &rarr;
        </a>
      )}
      {duration && (
        <span class="freq-badge">432 Hz &middot; {duration}</span>
      )}
    </div>

    {audioSrc && (
      <div style="margin-top: 18px;">
        <div style="font-family: var(--font-inscription); font-size: 0.62rem; letter-spacing: 0.14em; color: var(--accent-gold); text-transform: uppercase; margin-bottom: 8px;">
          &#127908; MUESTRA ACÚSTICA
        </div>
        <audio controls src={audioSrc} style="width: 100%; height: 38px; filter: sepia(10%);"></audio>
      </div>
    )}
  </div>
</article>
