---
// Reproductor Zen Contemplativo — Munay Amaru Pabellón Sonoro
// Diseño inspirado en Fondazione Prada & Chichu Art Museum (Tadao Ando)
interface Props {
  src: string;
  title: string;
  category?: string;
  duration?: string;
  gear?: string;
  location?: string;
  trackId: string;
}

const { src, title, category = 'REGISTRO ACÚSTICO', duration = '03:30', gear, location, trackId } = Astro.props;
---

<div class="zen-audio-player sanctuary-player" data-track-id={trackId} data-audio-src={src}>
  <!-- Cédula Sonora -->
  <div class="player-header">
    <div>
      <span class="inv-code" style="margin-bottom: 2px;">{category}</span>
      <h3 style="font-family: var(--font-display); font-size: 1.3rem; font-weight: 500; margin-top: 2px; color: var(--ink-primary); line-height: 1.2;">{title}</h3>
    </div>
    <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
      <span class="resonance-pill">
        <span class="pulse-dot" aria-hidden="true"></span>
        432 Hz
      </span>
      <span class="duration-chip">{duration}</span>
    </div>
  </div>

  {location && (
    <div style="font-size: 0.8rem; color: var(--ink-muted); display: flex; align-items: center; gap: 6px; margin-bottom: 14px; margin-top: -4px;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>{location}</span>
    </div>
  )}

  <!-- Controles Táctiles Zen -->
  <div class="player-interface">
    <button class="play-trigger" aria-label={`Reproducir ${title}`} data-play-btn>
      <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <polygon points="6 3 20 12 6 21 6 3"></polygon>
      </svg>
      <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none;">
        <rect x="5" y="4" width="4" height="16"></rect><rect x="15" y="4" width="4" height="16"></rect>
      </svg>
    </button>

    <div class="scrub-wrap">
      <div class="progress-bar-bg" data-scrub-bar role="slider" aria-label={`Progreso de ${title}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="progress-fill" data-progress-fill></div>
        <div class="progress-thumb" data-progress-thumb></div>
      </div>
      <div class="time-row">
        <span data-time-current>00:00</span>
        <span data-time-end>{duration}</span>
      </div>
    </div>
  </div>

  {gear && (
    <div style="display: flex; gap: 10px; align-items: flex-start; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border-hairline); font-size: 0.78rem; color: var(--ink-muted); line-height: 1.5;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
      <div>
        <span style="font-family: var(--font-inscription); font-size: 0.6rem; letter-spacing: 0.12em; color: var(--accent-gold); display: block; margin-bottom: 2px; text-transform: uppercase;">INGENIERÍA & CADENA DE REGISTRO</span>
        {gear}
      </div>
    </div>
  )}

  <audio preload="none" src={src} data-native-audio style="display: none;"></audio>
</div>

<style>
  .zen-audio-player.is-playing { border-color: var(--accent-gold); box-shadow: 0 4px 20px -2px hsla(42, 48%, 52%, 0.12); }

  .resonance-pill {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--font-inscription); font-size: 0.66rem; letter-spacing: 0.14em;
    padding: 3px 8px; border-radius: 2px;
    background: var(--moss-50); color: var(--moss-800); border: 1px solid var(--moss-100);
    white-space: nowrap;
  }

  .pulse-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent-moss); display: inline-block; flex-shrink: 0;
  }
  .is-playing .pulse-dot { animation: dot-pulse 1.5s ease-in-out infinite; }
  @keyframes dot-pulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.7); opacity: 0.3; }
  }

  .duration-chip {
    font-family: var(--font-inscription); font-size: 0.68rem;
    color: var(--ink-faint); letter-spacing: 0.1em;
  }

  .player-interface {
    display: flex; align-items: center; gap: 14px; margin-top: 14px;
    background: var(--bg-card-warm); padding: 10px 14px;
    border-radius: 4px; border: 1px solid var(--border-hairline);
  }

  .play-trigger {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--ink-primary); color: var(--limestone-50);
    border: none; display: flex; align-items: center; justify-content: center;
    cursor: pointer; flex-shrink: 0;
    transition: transform 0.15s ease, background-color 0.2s ease;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  .play-trigger:active { transform: scale(0.9); }

  .scrub-wrap { flex: 1; display: flex; flex-direction: column; gap: 5px; min-width: 0; }

  .progress-bar-bg {
    width: 100%; height: 20px;
    display: flex; align-items: center;
    position: relative; cursor: pointer; touch-action: none;
  }
  .progress-bar-bg::before {
    content: ''; position: absolute; left: 0; right: 0;
    height: 3px; background: var(--sumi-100); border-radius: 2px;
  }
  .progress-fill {
    position: absolute; left: 0; height: 3px;
    background: var(--accent-gold); border-radius: 2px;
    width: 0%; pointer-events: none;
  }
  .progress-thumb {
    position: absolute; left: 0%; width: 12px; height: 12px;
    border-radius: 50%; background: var(--ink-primary);
    border: 2px solid var(--limestone-50);
    box-shadow: 0 1px 4px hsla(0,0%,0%,0.2);
    transform: translateX(-50%); pointer-events: none;
  }

  .time-row {
    display: flex; justify-content: space-between;
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-faint);
  }
</style>

<script>
  if (!(window as any).__zenAudioDispatcher) {
    (window as any).__zenAudioDispatcher = true;

    let activeAudio: HTMLAudioElement | null = null;
    let activePlayer: HTMLElement | null = null;

    function fmt(s: number) {
      if (!isFinite(s)) return '00:00';
      const m = Math.floor(s / 60), sec = Math.floor(s % 60);
      return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
    }

    function setState(player: HTMLElement, playing: boolean) {
      (player.querySelector('.icon-play') as HTMLElement).style.display = playing ? 'none' : 'block';
      (player.querySelector('.icon-pause') as HTMLElement).style.display = playing ? 'block' : 'none';
      player.classList.toggle('is-playing', playing);
    }

    document.querySelectorAll<HTMLElement>('.zen-audio-player').forEach(player => {
      const audio = player.querySelector<HTMLAudioElement>('[data-native-audio]')!;
      const btn = player.querySelector<HTMLButtonElement>('[data-play-btn]')!;
      const bar = player.querySelector<HTMLElement>('[data-scrub-bar]')!;
      const fill = player.querySelector<HTMLElement>('[data-progress-fill]')!;
      const thumb = player.querySelector<HTMLElement>('[data-progress-thumb]')!;
      const cur = player.querySelector<HTMLElement>('[data-time-current]')!;
      const end = player.querySelector<HTMLElement>('[data-time-end]')!;
      const titleEl = player.querySelector('h3');

      btn.addEventListener('click', () => {
        if (!audio.paused) {
          audio.pause(); setState(player, false);
        } else {
          if (activeAudio && activeAudio !== audio) { activeAudio.pause(); if (activePlayer) setState(activePlayer, false); }
          audio.play().then(() => {
            activeAudio = audio; activePlayer = player; setState(player, true);
            if ('vibrate' in navigator) navigator.vibrate(20);
            if ('mediaSession' in navigator) {
              navigator.mediaSession.metadata = new MediaMetadata({
                title: titleEl?.textContent || 'Munay Amaru',
                artist: 'Munay Amaru · Omar Franco',
                album: 'Pabellón Sonoro 432 Hz',
                artwork: [{ src: 'https://f4.bcbits.com/img/a3993646546_2.jpg', sizes: '512x512', type: 'image/jpeg' }]
              });
              navigator.mediaSession.setActionHandler('play', () => audio.play());
              navigator.mediaSession.setActionHandler('pause', () => audio.pause());
            }
          }).catch(() => {});
        }
      });

      audio.addEventListener('timeupdate', () => {
        if (!audio.duration) return;
        const p = audio.currentTime / audio.duration;
        fill.style.width = `${p * 100}%`;
        thumb.style.left = `${p * 100}%`;
        cur.textContent = fmt(audio.currentTime);
      });

      audio.addEventListener('loadedmetadata', () => { end.textContent = fmt(audio.duration); });
      audio.addEventListener('ended', () => { setState(player, false); fill.style.width='0%'; thumb.style.left='0%'; cur.textContent='00:00'; });

      let dragging = false;
      const seek = (e: MouseEvent | TouchEvent) => {
        const rect = bar.getBoundingClientRect();
        const x = 'touches' in e ? e.touches[0].clientX : e.clientX;
        const p = Math.max(0, Math.min(1, (x - rect.left) / rect.width));
        if (audio.duration) audio.currentTime = p * audio.duration;
      };
      bar.addEventListener('mousedown', e => { dragging = true; seek(e); });
      bar.addEventListener('touchstart', e => { dragging = true; seek(e); }, { passive: true });
      window.addEventListener('mousemove', e => { if (dragging) seek(e); });
      window.addEventListener('touchmove', e => { if (dragging) seek(e as TouchEvent); }, { passive: true });
      window.addEventListener('mouseup', () => { dragging = false; });
      window.addEventListener('touchend', () => { dragging = false; });
    });
  }
</script>
