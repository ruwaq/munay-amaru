---
import { LOCALES } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
interface Props { currentLocale: Locale; translationUrl?: string | null; hasTranslation?: boolean; }
const { currentLocale, translationUrl = null, hasTranslation = false } = Astro.props;
---

<nav class="lang-switcher" aria-label={currentLocale === 'es' ? 'Selector de idioma' : 'Language selector'}>
  <ul class="lang-list">
    <li>
      {currentLocale === 'es' ? (
        <span class="lang-btn active" aria-current="page">{LOCALES.es.label}</span>
      ) : (
        <a href={translationUrl || '/'} class="lang-btn" hreflang="es">{LOCALES.es.label}</a>
      )}
    </li>
    <li aria-hidden="true" class="lang-divider">&middot;</li>
    <li>
      {currentLocale === 'en' ? (
        <span class="lang-btn active" aria-current="page">{LOCALES.en.label}</span>
      ) : hasTranslation && translationUrl ? (
        <a href={translationUrl} class="lang-btn" hreflang="en">{LOCALES.en.label}</a>
      ) : (
        <span class="lang-btn disabled" aria-disabled="true" title="Esta sala solo existe en español">{LOCALES.en.label}</span>
      )}
    </li>
  </ul>
</nav>
