---
interface Props {
  invNumber: string;
  artist: string;
  title: string;
  year: string;
  medium: string;
  dimensions?: string;
  duration?: string;
  provenance?: string;
  concept: string;
  credits: string;
  imageSrc: string;
  imageAlt: string;
  linkUrl?: string;
  audioSrc?: string;
}

const { invNumber, artist, title, year, medium, dimensions, duration, provenance, concept, credits, imageSrc, imageAlt, linkUrl, audioSrc } = Astro.props;

// Schema.org VisualArtwork para SEO semántico
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": title,
  "creator": { "@type": "Person", "name": artist },
  "dateCreated": year,
  "artMedium": medium,
  "description": concept,
  "image": imageSrc,
  "url": linkUrl || undefined,
});
---

<script is:inline type="application/ld+json" set:html={schema}></script>

<article style="border: 1px solid var(--rule); background: var(--bg-card); margin-bottom: 40px;" itemscope itemtype="https://schema.org/VisualArtwork">
  <!-- Lámina / Grabado de Prensa -->
  <div style="padding: clamp(14px, 3vw, 24px); border-bottom: 1px solid var(--rule); background: var(--bg);">
    {linkUrl ? (
      <a href={linkUrl} target="_blank" rel="noopener noreferrer" style="display: block; text-decoration: none;" aria-label={`Ver lámina ${title} de ${artist}`}>
        <img
          src={imageSrc}
          alt={imageAlt}
          class="newspaper-engraving"
          loading="lazy"
          decoding="async"
          itemprop="image"
        />
      </a>
    ) : (
      <img
        src={imageSrc}
        alt={imageAlt}
        class="newspaper-engraving"
        loading="lazy"
        decoding="async"
        itemprop="image"
      />
    )}
    <p class="engraving-caption" style="margin-bottom: 0; border-bottom: none; padding-bottom: 0;">
      Lámina — «{title}» ({year}). {medium}
    </p>
  </div>

  <!-- Ficha de Taller / Libreta de Registro -->
  <div style="padding: 20px 22px 22px;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--ink-muted); letter-spacing: 0.1em;">
        {invNumber}
      </span>
      {duration && (
        <span class="freq-badge">432 Hz &middot; {duration}</span>
      )}
    </div>

    <h3 style="font-family: var(--font-display); font-size: 1.55rem; font-weight: 500; color: var(--ink); line-height: 1.2; margin-bottom: 4px;" itemprop="creator">
      {artist}
    </h3>
    <div style="font-family: var(--font-display); font-size: 1.1rem; font-style: italic; color: var(--ink-muted); margin-bottom: 14px;">
      <em itemprop="name">{title}</em>, <span itemprop="dateCreated">{year}</span>
    </div>

    <div style="font-size: 0.8rem; line-height: 1.6; color: var(--ink-muted); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 9px 0; margin-bottom: 14px;">
      <div><strong>Técnica:</strong> <span itemprop="artMedium">{medium}</span></div>
      {dimensions && <div><strong>Soporte / Medida:</strong> {dimensions}</div>}
      {provenance && <div><strong>Origen / Residencia:</strong> {provenance}</div>}
    </div>

    <p style="font-family: var(--font-display); font-size: 1.05rem; line-height: 1.75; color: var(--ink-body); margin-bottom: 14px;" itemprop="description">
      {concept}
    </p>

    <div style="font-size: 0.78rem; color: var(--ink-faint); margin-bottom: 16px; display: flex; align-items: flex-start; gap: 6px;">
      <span aria-hidden="true">&#9998;</span>
      <span>{credits}</span>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      {linkUrl && (
        <a
          href={linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="font-family: var(--font-body); font-size: 0.82rem; font-weight: 500; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; min-height: 44px; display: inline-flex; align-items: center;"
          itemprop="url"
        >
          Ver en Bandcamp &rarr;
        </a>
      )}
    </div>

    {audioSrc && (
      <div style="margin-top: 16px; border-top: 1px dashed var(--rule); padding-top: 12px;">
        <div style="font-family: var(--font-label); font-size: 0.6rem; letter-spacing: 0.14em; color: var(--gold); text-transform: uppercase; margin-bottom: 6px;">
          CINTA DE AUDIO ASOCIADA
        </div>
        <audio controls src={audioSrc} style="width: 100%; height: 36px;"></audio>
      </div>
    )}
  </div>
</article>
