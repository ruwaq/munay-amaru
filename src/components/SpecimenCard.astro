---
// SpecimenCard.astro: Lámina de Herbario Botánico & Canto Rodado (Acceso en 1 Clic)
interface Props {
  id: string;
  title: string;
  category: string;
  hemisphere?: 'centro' | 'izquierdo' | 'derecho';
  year?: string;
  creator?: string;
  medium?: string;
  origin?: string;
  synergy?: string;
  verses?: string[];
  excerpt?: string;
  quote?: string;
  concept?: string;
  audioSrc?: string;
  duration?: string;
  postUrl: string;
  sizeClass?: 'hero' | 'standard';
}

const {
  id,
  title,
  category,
  hemisphere = 'centro',
  year = '2026',
  creator = 'Munay Amaru',
  medium,
  origin,
  synergy,
  verses,
  excerpt,
  quote,
  concept,
  audioSrc,
  duration,
  postUrl,
  sizeClass = 'standard',
} = Astro.props;

const stratumLabel = 
  hemisphere === 'izquierdo' ? '🌱 Raíz & Suelo · Cuentos y Psique' :
  hemisphere === 'derecho' ? '🍃 Rama & Viento · Resonancia Acústica en 432 Hz' :
  '☀️ Fuego Central · Ayni & Tótem Fundacional';
---

<a 
  href={postUrl}
  id={id} 
  class={`specimen-card botanical-plate specimen-${sizeClass} stratum-${hemisphere}`}
  data-specimen-id={id}
  data-title={title}
  data-post-url={postUrl}
>
  <!-- Cinta de Lino Engomado de Herbario (Sujeción Natural) -->
  <span class="linen-fastener" aria-hidden="true"></span>

  <!-- Cabecera Botánica -->
  <header class="botanical-header">
    <span class="botanical-stratum-tag">{stratumLabel}</span>
    <span class="botanical-category">{category}</span>
  </header>

  <!-- Título de la Creación -->
  <div class="botanical-title-wrap">
    <h3 class="botanical-title">{title}</h3>
    <div class="botanical-author-line">
      <span>{creator}</span>
      {year && <span>&middot; {year}</span>}
      {origin && <span>&middot; 🌿 {origin}</span>}
    </div>
  </div>

  <!-- Pliego Central: El Arte se Muestra Directamente al Inicio -->
  <div class="botanical-art-plate">
    {verses && verses.length > 0 ? (
      <div class="art-verses">
        {verses.map((v) => (
          <span class="verse-line">{v}</span>
        ))}
      </div>
    ) : excerpt ? (
      <p class="art-narrative">{excerpt}</p>
    ) : quote ? (
      <blockquote class="art-quote">«{quote}»</blockquote>
    ) : (
      <p class="art-concept">{concept}</p>
    )}
  </div>

  <!-- Si es pieza sonora: Consola de Madera Acústica en 432 Hz -->
  {audioSrc && (
    <div 
      class="wooden-audio-bar" 
      onclick="event.stopPropagation();"
      onkeydown="event.stopPropagation();"
    >
      <div class="audio-bar-meta">
        <span class="audio-pulse-indicator">&#9835; 432 Hz {duration ? `· ${duration}` : ''}</span>
        <span class="audio-hint">Escucha directa de la tierra</span>
      </div>
      <audio 
        controls 
        preload="none" 
        src={audioSrc}
        class="direct-audio-player"
      ></audio>
    </div>
  )}

  <!-- Pie de la Lámina: 1 Clic Directo a la Obra Completa -->
  <footer class="botanical-footer">
    {synergy && (
      <span class="botanical-symbiosis-hint">
        <strong>Simbiosis:</strong> {synergy}
      </span>
    )}
    <span class="botanical-enter-action">
      <span>Abrir pliego</span>
      <span class="enter-arrow" aria-hidden="true">&rarr;</span>
    </span>
  </footer>
</a>

<style>
  .botanical-plate {
    position: relative;
    background: 
      linear-gradient(180deg, 
        rgba(75, 48, 30, 0.4) 0%, 
        rgba(50, 31, 20, 0.6) 24%, 
        rgba(85, 52, 33, 0.35) 26%, 
        rgba(58, 36, 23, 0.7) 58%, 
        rgba(42, 26, 17, 0.85) 80%, 
        rgba(68, 42, 27, 0.45) 82%, 
        rgba(36, 22, 14, 0.95) 100%
      ),
      radial-gradient(ellipse at 85% 15%, rgba(223, 162, 58, 0.08) 0%, transparent 60%),
      #241810;
    border: 1.5px solid #4a3322;
    border-radius: 18px 12px 18px 12px;
    padding: 24px 22px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s cubic-bezier(0.2, 0, 0.2, 1), 
                border-color 0.35s ease, 
                box-shadow 0.35s ease,
                background 0.35s ease;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55), 
                inset 0 1px 0 rgba(240, 188, 94, 0.15),
                inset 0 0 16px rgba(0, 0, 0, 0.25);
  }

  .botanical-plate:hover {
    border-color: var(--gold);
    background: 
      linear-gradient(180deg, 
        rgba(90, 58, 36, 0.5) 0%, 
        rgba(62, 38, 25, 0.7) 24%, 
        rgba(102, 64, 40, 0.45) 26%, 
        rgba(72, 45, 29, 0.8) 58%, 
        rgba(52, 33, 22, 0.9) 80%, 
        rgba(82, 52, 34, 0.55) 82%, 
        rgba(44, 28, 18, 0.98) 100%
      ),
      radial-gradient(ellipse at 85% 15%, rgba(223, 162, 58, 0.15) 0%, transparent 60%),
      #2c1d14;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.7), 
                0 0 24px rgba(223, 162, 58, 0.22),
                inset 0 1px 0 rgba(240, 188, 94, 0.3);
    transform: translateY(-4px) scale(1.01);
  }

  /* Remache de Greda y Arcilla Cocida */
  .linen-fastener {
    position: absolute;
    top: -6px;
    right: 24px;
    width: 36px;
    height: 12px;
    background: linear-gradient(90deg, #7a422b, #945037);
    border: 1px solid rgba(223, 162, 58, 0.5);
    border-radius: 2px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
    transform: rotate(2deg);
    pointer-events: none;
  }

  /* Resonancia biológica cuando una pared de tierra conectada por micelio está enfocada */
  :global(.botanical-plate.synergy-pulse) {
    border-color: var(--gold) !important;
    box-shadow: 0 0 24px hsla(38, 80%, 45%, 0.4), inset 0 0 12px hsla(38, 50%, 40%, 0.15) !important;
    transform: translateY(-2px);
  }

  /* Cabecera Botánica */
  .botanical-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--moss-alive);
    text-transform: uppercase;
    border-bottom: 1px dashed var(--rule);
    padding-bottom: 8px;
    margin-bottom: 12px;
  }

  .botanical-stratum-tag {
    font-weight: 600;
  }

  .botanical-category {
    color: var(--lichen-gray);
    font-size: 0.58rem;
  }

  /* Título de la Obra en Cal Blanca */
  .botanical-title-wrap {
    margin-bottom: 14px;
  }

  .botanical-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.2;
    margin: 0 0 4px;
    transition: color 0.2s ease;
  }

  .botanical-plate:hover .botanical-title {
    color: var(--gold-warm);
  }

  .botanical-author-line {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--ink-muted);
    letter-spacing: 0.06em;
  }

  /* Pliego Interior: Lecho de Arcilla y Humus */
  .botanical-art-plate {
    background: #140d07;
    border: 1px solid #3c2618;
    border-radius: 8px 12px 8px 12px;
    padding: 16px 14px;
    margin-bottom: 14px;
    box-shadow: inset 0 3px 8px rgba(0, 0, 0, 0.65), 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .art-verses {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .verse-line {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-style: italic;
    line-height: 1.58;
    color: var(--ink-body);
  }

  .art-quote {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
  }

  .art-narrative, .art-concept {
    font-family: var(--font-body);
    font-size: 0.86rem;
    line-height: 1.68;
    color: var(--ink-body);
    margin: 0;
  }

  /* Barra de Audio de Madera & Resonancia Acústica */
  .wooden-audio-bar {
    background: hsla(28, 28%, 14%, 0.85);
    border: 1px solid var(--rule-warm);
    border-radius: 8px;
    padding: 8px 10px;
    margin-bottom: 12px;
  }

  .audio-bar-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--moss-alive);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .audio-hint {
    color: var(--lichen-gray);
    font-size: 0.58rem;
  }

  .direct-audio-player {
    width: 100%;
    height: 32px;
    filter: sepia(35%) invert(15%);
  }

  /* Pie de la Pared Botánica */
  .botanical-footer {
    border-top: 1px solid var(--rule);
    padding-top: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .botanical-symbiosis-hint {
    font-size: 0.68rem;
    font-style: italic;
    color: var(--ink-muted);
  }
  .botanical-symbiosis-hint strong {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
    color: var(--gold);
    font-style: normal;
  }

  .botanical-enter-action {
    margin-left: auto;
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--ink);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .botanical-plate:hover .botanical-enter-action {
    color: var(--gold-warm);
    transform: translateX(3px);
  }

  .enter-arrow {
    color: var(--gold);
    font-size: 0.85rem;
  }

  /* Nodos Hero (Fuego Central / Manifiesto) */
  .specimen-hero {
    grid-column: span 2;
  }
  .specimen-hero .botanical-title {
    font-size: 2rem;
  }

  @media (max-width: 820px) {
    .specimen-hero {
      grid-column: span 1;
    }
  }
</style>

