---
interface Props {
  text: string;
  date?: string;
  mood?: string;
  class?: string;
  href?: string;
}

const { text, date, mood, class: extraClass = '', href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class={`scrap-note ${extraClass}`} style="display: block; text-decoration: none; color: inherit;">
  <div class="washi-tape top-left ochre" style="width: 70px; height: 20px;" aria-hidden="true"></div>
  {(date || mood) && (
    <span class="scrap-meta">
      {date}{date && mood ? ' · ' : ''}{mood}
    </span>
  )}
  <p style="margin: 0;">{text}</p>
</Tag>
