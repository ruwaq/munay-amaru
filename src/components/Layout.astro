---
// Layout base limpio — sin diseño. El nuevo diseño se construye desde cero.
import { SITE_TITLE, SITE_SUBTITLE, SITE_DESCRIPTION, SOCIAL_LINKS } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
  activePage?: string;
}

const {
  title,
  description,
  locale = 'es',
  activePage = 'home',
} = Astro.props;

const siteTitle = SITE_TITLE[locale];
const siteSubtitle = SITE_SUBTITLE[locale];
const pageTitle = title ? `${title} — ${siteTitle}` : `${siteTitle} · ${siteSubtitle}`;
const pageDesc = description || SITE_DESCRIPTION[locale];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://munay-amaru.pages.dev');
---

<!doctype html>
<html lang={locale === 'es' ? 'es' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="author" content="Munay Amaru (Omar Trillo)" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <link rel="alternate" type="application/rss+xml" title={`Feed RSS — ${siteTitle}`} href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Tipografías: se mantienen para el diseño nuevo -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Caveat:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>

<body>
  <a href="#main-content" style="position:absolute;top:-40px;left:0;z-index:9999;">
    Saltar al contenido
  </a>
  <main id="main-content">
    <slot />
  </main>
</body>
</html>
