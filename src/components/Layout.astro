---
import '../styles/vintage.css';
import BottomDock from './BottomDock.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SITE_TITLE, SITE_SUBTITLE, SITE_DESCRIPTION, SOCIAL_LINKS } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
  activePage?: string;
  translationUrl?: string | null;
  hasTranslation?: boolean;
}

const {
  title,
  description,
  image,
  locale = 'es',
  activePage = 'home',
  translationUrl = null,
  hasTranslation = false,
} = Astro.props;

const siteTitle = SITE_TITLE[locale];
const siteSubtitle = SITE_SUBTITLE[locale];
const pageTitle = title ? `${title} — ${siteTitle}` : `${siteTitle} · ${siteSubtitle}`;
const pageDesc = description || SITE_DESCRIPTION[locale];
const pageImage = image || 'https://f4.bcbits.com/img/a3993646546_2.jpg';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://munay-amaru.pages.dev');
---

<!doctype html>
<html lang={locale === 'es' ? 'es' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f4ef" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111417" />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="author" content="Munay Amaru (Omar Trillo)" />

  <link rel="alternate" hreflang="es" href={new URL('/', Astro.site || 'https://munay-amaru.pages.dev')} />
  <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site || 'https://munay-amaru.pages.dev')} />
  <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site || 'https://munay-amaru.pages.dev')} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content={pageImage} />
  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={pageImage} />

  <link rel="alternate" type="application/rss+xml" title={`Feed RSS — ${siteTitle}`} href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>

<body>
  <a href="#main-content" class="skip-link">
    {locale === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
  </a>

  <header class="site-header" role="banner">
    <div class="header-inner">
      <a href={locale === 'en' ? '/en/' : '/'} class="museum-brand" aria-label={siteTitle}>
        <span class="brand-title">{siteTitle}</span>
        <span class="brand-subtitle">{siteSubtitle}</span>
      </a>
      <LanguageSwitcher
        currentLocale={locale}
        translationUrl={translationUrl}
        hasTranslation={hasTranslation}
      />
    </div>
  </header>

  <main id="main-content" role="main" class="page-container">
    <slot />
  </main>

  <footer class="museum-footer" role="contentinfo">
    <div style="margin-bottom: 16px; display: flex; justify-content: center; gap: 18px; flex-wrap: wrap; font-family: var(--font-inscription); font-size: 0.72rem; letter-spacing: 0.12em;">
      <a href={SOCIAL_LINKS.bandcamp} target="_blank" rel="noopener noreferrer">Bandcamp &rarr;</a>
      <a href={SOCIAL_LINKS.soundcloud} target="_blank" rel="noopener noreferrer">SoundCloud &rarr;</a>
      <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer">YouTube &rarr;</a>
      <a href={SOCIAL_LINKS.linktree} target="_blank" rel="noopener noreferrer">Linktree &rarr;</a>
    </div>
    <p style="font-family: var(--font-display); font-size: 1.1rem; font-style: italic; color: var(--ink-muted); max-width: 50ch; margin: 0 auto 12px;">
      «Munay Amaru»: El poder del amor incondicional y la sabiduría primordial del agua andina.
    </p>
    <p style="margin-top: 8px;">
      <a href="mailto:munaysounds@gmail.com">Correspondencia con el artista &rarr;</a>
      &nbsp;&middot;&nbsp;
      <a href="/rss.xml">Suscripción RSS</a>
    </p>
    <p style="margin-top: 18px; font-family: var(--font-inscription); font-size: 0.66rem; letter-spacing: 0.18em; opacity: 0.5;">
      MUSEO · SANTUARIO MUNAY AMARU &copy; {new Date().getFullYear()}
    </p>
  </footer>

  <BottomDock activePage={activePage} locale={locale} />
</body>
</html>
