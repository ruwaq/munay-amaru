---
interface Props {
  src: string;
  title: string;
  artist?: string;
  duration?: string;
}

const { src, title, artist = 'Voz del autor', duration = '00:00' } = Astro.props;
---

<div class="vintage-player paper-card" style="padding: 16px; background-color: hsl(30 18% 18%); color: #f7f4ec; border-radius: 6px;">
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #6b6255; padding-bottom: 8px; margin-bottom: 12px; font-family: var(--font-typewriter); font-size: 0.75rem; letter-spacing: 0.05em;">
    <span style="color: #e5b364;">&#9654; REEL: A-SIDE</span>
    <span style="color: #bbb;">{duration}</span>
  </div>

  <div style="background: #f7f4ec; color: #24211e; padding: 8px 12px; border-radius: 4px; margin-bottom: 12px; font-family: var(--font-typewriter); border: 1px solid #dcd4c5;">
    <div style="font-weight: bold; font-size: 0.85rem; text-transform: uppercase;">{title}</div>
    <div style="font-size: 0.72rem; color: #666;">{artist}</div>
  </div>

  <audio src={src} preload="metadata" style="width: 100%; height: 36px; filter: sepia(0.3) invert(0.85);" controls></audio>
</div>
