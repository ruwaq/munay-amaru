---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  date?: string;
  tapeColor?: 'moss' | 'petrol' | 'ochre' | '';
  href?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  date,
  tapeColor = '',
  href,
  class: extraClass = '',
} = Astro.props;

const Tag = href ? 'a' : 'figure';
---

<Tag href={href} class={`polaroid-frame ${extraClass}`} style="display: inline-flex; flex-direction: column; text-decoration: none; color: inherit;">
  <div class={`washi-tape top-center ${tapeColor}`} aria-hidden="true"></div>
  <div class="polaroid-photo">
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </div>
  {(caption || date) && (
    <figcaption class="polaroid-caption" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
      {caption && <span style="text-align: left; flex: 1;">{caption}</span>}
      {date && <span style="flex-shrink: 0; opacity: 0.7;">{date}</span>}
    </figcaption>
  )}
</Tag>
