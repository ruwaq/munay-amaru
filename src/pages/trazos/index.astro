---
import Layout from '../../components/Layout.astro';
import { SOCIAL_LINKS } from '../../utils/i18n';

// 8 obras de trazos — datos preservados, diseño nuevo a construir
const obras = [
  {
    title: 'Munay (Corazón Radiante)',
    categoria: 'Pastel & Voluntad · 2026',
    fragmento: 'Silueta iluminada con corazón ardiente. La voluntad afectiva que no evade el dolor del mundo.',
    url: '/trazos/',
  },
  {
    title: 'I Am a Tree',
    categoria: 'Óleo Botánico & 432 Hz · 2024',
    fragmento: 'Eliana Colzani & Munay Amaru. Małopolska y Kazimierz, Cracovia.',
    url: '/posts/sonidos-i-am-a-tree/',
    imagen: 'https://f4.bcbits.com/img/a3993646546_2.jpg',
  },
  {
    title: 'Retrato de Riga (01/09/2016)',
    categoria: 'Tinta China & Libreta · 2016',
    fragmento: 'Agne Taur. El trazo a tinta sobre el papel de libreta detiene el viento del Báltico.',
    url: '/trazos/',
  },
  {
    title: 'The Magic Threads (Pipene & Gailene)',
    categoria: 'Fábula Botánica · 2016',
    fragmento: 'Bajo la nieve del Báltico, las raíces de Pipene y las hifas de Gailene se dan la mano en silencio.',
    url: '/trazos/',
  },
  {
    title: 'Hula Hop',
    categoria: 'Acrílico & Tintas Zen · 2024',
    fragmento: 'Eliana Colzani & Munay Amaru. El juego y la circularidad como prácticas de conciencia zen.',
    url: '/posts/sonidos-hula-hop/',
    imagen: 'https://f4.bcbits.com/img/a2669624191_2.jpg',
  },
  {
    title: 'Proyecto Tu Silencio!',
    categoria: 'Calcografía & Monotipia · 2016/2021',
    fragmento: 'Jimena Vílchez, Omar Franco & Munay Amaru. El blanco del papel no es vacío.',
    url: '/posts/sonidos-proyecto-tu-silencio/',
    imagen: 'https://f4.bcbits.com/img/0036122981_23.jpg',
  },
  {
    title: 'Dioses EP',
    categoria: 'Sumi-e Ritual · 2016',
    fragmento: 'Gastón Puray, Omar Franco & Munay Amaru. Ofrenda mineral a las fuerzas invisibles de la cordillera.',
    url: '/posts/sonidos-dioses/',
    imagen: 'https://f4.bcbits.com/img/a1715722282_2.jpg',
  },
  {
    title: 'Collage de Raíces & Valores',
    categoria: 'Collage de Ruta · 2016',
    fragmento: 'Roots, Love for the World, Spirituality, Journey, Creativity, Humble, Bravery, Simplicity.',
    url: '/trazos/',
  },
];
---

<Layout activePage="trazos" title="Trazos & Materia" locale="es">
  <!-- PÁGINA TEMPORAL: placeholder mientras se construye el diseño nuevo del bosque -->
  <div style="
    min-height: 100vh;
    background: #0c1210;
    color: #dce5df;
    font-family: 'Cormorant Garamond', Georgia, serif;
    padding: 4rem 2rem;
    max-width: 700px;
    margin: 0 auto;
  ">
    <a href="/" style="color: #c4a35a; font-size: 0.85rem; letter-spacing: 0.1em;">← Volver</a>
    <h1 style="font-size: clamp(2rem, 6vw, 3.5rem); margin: 2rem 0 0.5rem; letter-spacing: 0.1em;">
      Trazos & Materia
    </h1>
    <p style="opacity: 0.5; font-style: italic; margin-bottom: 3rem;">
      Óleos, tintas, pasteles & cuadernos de campo
    </p>
    <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 2rem;">
      {obras.map((obra) => (
        <li style="border-bottom: 1px solid #243028; padding-bottom: 1.5rem;">
          <a href={obra.url} style="color: #dce5df; text-decoration: none;">
            <div style="font-size: 0.75rem; letter-spacing: 0.15em; color: #c4a35a; margin-bottom: 0.3rem;">
              {obra.categoria}
            </div>
            <div style="font-size: 1.4rem; margin-bottom: 0.4rem;">{obra.title}</div>
            <div style="font-size: 0.9rem; opacity: 0.6; font-style: italic;">{obra.fragmento}</div>
          </a>
        </li>
      ))}
    </ul>

    <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #243028; display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.8rem;">
      <a href={SOCIAL_LINKS.bandcamp} target="_blank" rel="noopener noreferrer" style="color: #c4a35a;">Bandcamp →</a>
      <a href={SOCIAL_LINKS.soundcloud} target="_blank" rel="noopener noreferrer" style="color: #c4a35a;">SoundCloud →</a>
      <a href="https://audius.co/munaysounds" target="_blank" rel="noopener noreferrer" style="color: #c4a35a;">Audius →</a>
    </div>
  </div>
</Layout>
