---
import Layout from '../../components/Layout.astro';
import MuseumExhibit from '../../components/MuseumExhibit.astro';
import { SOCIAL_LINKS } from '../../utils/i18n';

const exhibits = [
  {
    invNumber: 'MS-COL-2024-001 · COLECCIÓN PERMANENTE',
    artist: 'ELIANA COLZANI & MUNAY AMARU',
    title: 'I Am a Tree',
    year: '2024',
    medium: 'Óleo botánico sobre lino natural & paisaje sonoro en 432 Hz',
    dimensions: '60 × 60 cm (Lienzo) · 03:10 min (Audio en bucle)',
    provenance: 'Residencia en Małopolska y sesiones en Kazimierz, Cracovia (Polonia)',
    concept: '«I Am a Tree» explora la interconectividad subterránea del micelio y la memoria vegetal como arquetipo de arraigo espiritual en el nomadismo. La obra pictórica de Eliana Colzani articula una morfología arbórea donde los tonos ocres y verdes dialogan con la composición acústica de Munay Amaru.',
    credits: 'Obra visual: Eliana Colzani · Composición sonora y guitarras: Munay Amaru · Masterización analógica',
    imageSrc: 'https://f4.bcbits.com/img/a3993646546_2.jpg',
    imageAlt: 'Obra I Am a Tree de Eliana Colzani',
    linkUrl: 'https://munaysounds.bandcamp.com/album/nacer',
    audioSrc: '/audio/ejemplo-voz.mp3'
  },
  {
    invNumber: 'MS-COL-2024-002 · COLECCIÓN PERMANENTE',
    artist: 'ELIANA COLZANI & MUNAY AMARU',
    title: 'Hula Hop',
    year: '2024',
    medium: 'Acrílico y tintas orgánicas sobre papel de algodón 300g & pieza musical acústica',
    dimensions: '45 × 45 cm (Papel montado en flotación) · 03:12 min',
    provenance: 'Diálogo transcontinental Lima – Europa',
    concept: 'Frente a la gravedad del viaje existencial, «Hula Hop» reivindica el juego, la circularidad y la liviandad como prácticas de conciencia zen. La pieza plástica de Colzani captura la energía cinética y el pulso orbital del aro, acompañada por el ritmo lúdico de Munay Amaru.',
    credits: 'Obra visual de portada: Eliana Colzani · Composición y ukelele: Munay Amaru',
    imageSrc: 'https://f4.bcbits.com/img/a2669624191_2.jpg',
    imageAlt: 'Obra Hula Hop de Eliana Colzani',
    linkUrl: 'https://munaysounds.bandcamp.com/track/hula-hop'
  },
  {
    invNumber: 'MS-COL-2016-003 · FONOTECA & ARCHIVO HISTÓRICO',
    artist: 'JIMENA VÍLCHEZ, OMAR FRANCO & MUNAY AMARU',
    title: 'Proyecto Tu Silencio!',
    year: '2016 / 2021',
    medium: 'Calcografía, monotipia y transferencia textil & tríptico sonoro en cinta magnetofónica',
    dimensions: '70 × 50 cm (Obra gráfica) · 12:48 min (Suite de 3 movimientos)',
    provenance: 'Taller Sonoro & Gráfico, Lima, Perú',
    concept: '«Proyecto Tu Silencio!» constituye una investigación estética fundamental sobre el valor de la pausa y el vacío fértil. La obra de Jimena Vílchez trabaja el soporte como un territorio de texturas ausentes donde los blancos encarnan el silencio visual, amplificado por la ingeniería acústica de Omar Franco.',
    credits: 'Obra y disposición visual: Jimena Vílchez · Grabación y mezcla analógica: Omar Franco · Composición: Munay Amaru',
    imageSrc: 'https://f4.bcbits.com/img/0036122981_23.jpg',
    imageAlt: 'Obra Proyecto Tu Silencio! de Jimena Vílchez',
    linkUrl: 'https://munaysounds.bandcamp.com/album/proyecto-tu-silencio'
  },
  {
    invNumber: 'MS-COL-2016-004 · FONOTECA & ARCHIVO HISTÓRICO',
    artist: 'GASTÓN PURAY [@gastipuray], OMAR FRANCO & MUNAY AMARU',
    title: 'Dioses EP',
    year: '2016',
    medium: 'Tinta china ritual sumi-e en alto contraste y serigrafía & síntesis analógica andina',
    dimensions: '50 × 50 cm (Enmarcado vitrina) · 09:40 min',
    provenance: 'Valle Sagrado de los Incas, Cusco & Lima, Perú',
    concept: 'Ofrenda sonora y plástica a los Apus tutelares y a las fuerzas invisibles del paisaje andino. La iconografía de Gastón Puray conjura el misticismo precolombino a través de gestos gráficos rotundos, fundiéndose con los vientos rituales y la mezcla espacial de Omar Franco.',
    credits: 'Obra visual: Gastón Puray (@gastipuray) · Grabación, mezcla y masterización: Omar Franco · Música: Munay Amaru',
    imageSrc: 'https://f4.bcbits.com/img/a1715722282_2.jpg',
    imageAlt: 'Obra Dioses EP de Gastón Puray',
    linkUrl: 'https://munaysounds.bandcamp.com/album/dioses-ep'
  },
  {
    invNumber: 'MS-AUD-2024-005 · ESCULTURA SONORA',
    artist: 'MUNAY AMARU',
    title: 'Piedras al Mar',
    year: '2024',
    medium: 'Cantos rodados marinos del Pacífico, hidrófono y guitarra acústica de 12 cuerdas',
    dimensions: 'Escultura de suelo 80 × 80 cm · 03:45 min',
    provenance: 'Litoral del Océano Pacífico, Perú',
    concept: 'Lanzar una piedra al mar no es una despedida: es una forma de medir la hondura de la calma interior. Las piedras que bajaron de la cordillera dialogan con las cuerdas de guitarra y el rumor de la marea viva.',
    credits: 'Concepto, composición y guitarras: Munay Amaru',
    imageSrc: 'https://f4.bcbits.com/img/a1208244140_2.jpg',
    imageAlt: 'Obra Piedras al Mar',
    linkUrl: 'https://munaysounds.bandcamp.com/track/piedras-al-mar'
  },
  {
    invNumber: 'MS-ALB-2021-007 · PABELLÓN CÓSMICO',
    artist: 'MUNAY AMARU',
    title: 'Partes Del Universo',
    year: '2021',
    medium: 'Suites cósmicas y frecuencias continuas a 432 Hz',
    dimensions: 'Álbum conceptual completo en Audius',
    provenance: 'Tawantinsuyu & Espacio Digital',
    concept: 'Investigación sonora sobre las cuatro direcciones de la cosmología andina, la geometría sagrada y la armonización del pulso biológico con la resonancia de los astros.',
    credits: 'Producción y diseño sonoro: Munay Amaru',
    imageSrc: 'https://f4.bcbits.com/img/0036122981_23.jpg',
    imageAlt: 'Álbum Partes Del Universo',
    linkUrl: 'https://audius.co/munaysounds'
  }
];
---

<Layout activePage="shop" title="Galería de Obras" locale="es">
  <div style="margin-bottom: 40px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 20px;">
    <span class="inv-code" style="margin-bottom: 6px;">COLECCIÓN PERMANENTE &middot; ARTES PLÁSTICAS Y SONIDO</span>
    <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 400; color: var(--ink-primary); line-height: 1.15; margin-top: 4px;">
      Galería de Obras &amp; Álbumes
    </h1>
    <p style="font-family: var(--font-display); font-size: 1.2rem; font-style: italic; color: var(--ink-muted); max-width: 58ch; margin-top: 8px;">
      Vitrinas de arte contemporáneo con las colaboraciones plásticas de <strong>Eliana Colzani</strong>, <strong>Jimena Vílchez</strong>, <strong>@gastipuray</strong> y <strong>Omar Franco</strong>.
    </p>
  </div>

  <!-- Lista de vitrinas de museo -->
  <div style="display: grid; grid-template-columns: 1fr; gap: 40px; margin-bottom: 60px;">
    {exhibits.map((exhibit) => (
      <MuseumExhibit {...exhibit} />
    ))}
  </div>

  <!-- Manifiesto de difusión libre -->
  <section class="zen-card" style="text-align: center; padding: 40px 24px; border-top: 2px solid var(--accent-gold);">
    <span class="inv-code" style="margin-bottom: 10px;">DIFUSIÓN LIBRE &middot; AYNI CREATIVO</span>
    <h3 style="font-family: var(--font-display); font-size: 1.6rem; color: var(--ink-primary); margin-bottom: 10px;">
      Todos los derechos no reservados
    </h3>
    <p style="font-family: var(--font-display); font-size: 1.15rem; font-style: italic; color: var(--ink-muted); max-width: 50ch; margin: 0 auto 20px;">
      Nuestras obras y música buscan circular como ofrendas libres. Puedes escucharlas en alta resolución o adquirirlas en las plataformas de los artistas.
    </p>
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href={SOCIAL_LINKS.bandcamp} target="_blank" rel="noopener noreferrer" style="font-family: var(--font-body); font-size: 0.85rem; font-weight: 600; color: var(--ink-primary); text-decoration: underline;">
        Bandcamp Oficial &rarr;
      </a>
      <a href={SOCIAL_LINKS.soundcloud} target="_blank" rel="noopener noreferrer" style="font-family: var(--font-body); font-size: 0.85rem; font-weight: 600; color: var(--ink-primary); text-decoration: underline;">
        SoundCloud &rarr;
      </a>
      <a href="https://audius.co/munaysounds" target="_blank" rel="noopener noreferrer" style="font-family: var(--font-body); font-size: 0.85rem; font-weight: 600; color: var(--ink-primary); text-decoration: underline;">
        Audius &rarr;
      </a>
    </div>
  </section>
</Layout>
