---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const allSonidos = await getCollection('sonidos', ({ data }) => !data.draft);
allSonidos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout activePage="sounds" title="Pabellón Sonoro & Meditación 432Hz" locale="es">
  <div style="margin-bottom: 40px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 20px;">
    <span class="inv-code" style="margin-bottom: 6px;">SALA ACÚSTICA &middot; FRECUENCIAS SAGRADAS</span>
    <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 400; color: var(--ink-primary); line-height: 1.15; margin-top: 4px;">
      Pabellón Sonoro &amp; Meditación
    </h1>
    <p style="font-family: var(--font-display); font-size: 1.2rem; font-style: italic; color: var(--ink-muted); max-width: 56ch; margin-top: 8px;">
      Paisajes acústicos, afinaciones naturales a 432 Hz y grabaciones de campo concebidas como espacios de desaceleración y escucha profunda.
    </p>
  </div>

  <!-- Círculo de Respiración & Meditación Guía -->
  <section class="zen-card" style="text-align: center; padding: clamp(30px, 5vw, 48px); margin-bottom: 40px; background: var(--bg-card-warm);">
    <span class="inv-code" style="margin-bottom: 12px;">CÍRCULO SAMAY &middot; RESPIRACIÓN CONSCIENTE (4-4-6-2)</span>
    <div class="samay-circle">
      <span style="font-family: var(--font-inscription); font-size: 0.72rem; color: var(--accent-gold); letter-spacing: 0.1em; font-weight: 600;">432 Hz</span>
    </div>
    <p style="font-family: var(--font-display); font-size: 1.25rem; font-style: italic; color: var(--ink-primary); max-width: 46ch; margin: 0 auto 12px;">
      Inhala el silencio (4s) &middot; Habita la calma (4s) &middot; Suelta el peso (6s) &middot; Vacío fértil (2s).
    </p>
    <span style="font-size: 0.8rem; color: var(--ink-muted);">Conecta auriculares para experimentar la espacialidad binaural.</span>
  </section>

  <!-- Lista de piezas sonoras en formato plinto de sala -->
  <div style="display: grid; grid-template-columns: 1fr; gap: 24px; margin-bottom: 50px;">
    {allSonidos.map((track) => (
      <article class="sanctuary-player">
        <div class="player-header">
          <div>
            <span class="inv-code" style="margin-bottom: 2px;">
              {track.data.category.toUpperCase().replace('_', ' ')}
            </span>
            <h2 style="font-family: var(--font-display); font-size: 1.55rem; font-weight: 500; margin-top: 2px;">
              <a href={`/posts/sonidos-${track.id.replace(/\.md$/, '')}/`} style="color: inherit; text-decoration: none;">
                {track.data.title}
              </a>
            </h2>
          </div>
          <span class="freq-badge">432 Hz &middot; {track.data.audio.duration || '03:30'}</span>
        </div>

        {track.data.location && (
          <div style="font-size: 0.82rem; color: var(--ink-muted); margin-bottom: 12px;">
            📍 {track.data.location.name} {track.data.location.country && `(${track.data.location.country})`}
          </div>
        )}

        {track.data.gear && (
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-faint); margin-bottom: 14px;">
            🎙️ {track.data.gear}
          </div>
        )}

        <div style="margin-top: 14px;">
          <audio controls src={track.data.audio.src} style="width: 100%; height: 38px; filter: sepia(10%);"></audio>
        </div>

        <div style="margin-top: 12px; display: flex; justify-content: flex-end;">
          <a href={`/posts/sonidos-${track.id.replace(/\.md$/, '')}/`} style="font-size: 0.82rem; font-weight: 500; color: var(--ink-primary); text-decoration: underline; text-underline-offset: 3px;">
            Leer notas de grabación &rarr;
          </a>
        </div>
      </article>
    ))}
  </div>
</Layout>
