---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import { SOCIAL_LINKS } from '../../utils/i18n';

const allSonidos = await getCollection('sonidos', ({ data }) => !data.draft);
allSonidos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout activePage="sounds" title="Sonidos en 432 Hz" locale="es">
  <div class="page-container">
    <a href="/" class="back-link">&larr; Volver al inicio</a>

    <header class="page-header">
      <span class="section-eyebrow">Resonancia Acústica &middot; 432 Hz</span>
      <h1 class="page-title">Sonidos del Bosque</h1>
      <p class="page-description">
        Cantos de medicina, charango, grabaciones de campo y cuerdas templadas a 432 Hz.
      </p>
    </header>

    <div class="sound-list">
      {allSonidos.map((track) => (
        <article class="sound-card">
          <div class="sound-card-header">
            <h2 class="sound-card-title">
              <a href={`/posts/sonidos-${track.id.replace(/\.md$/, '')}/`}>
                {track.data.title}
              </a>
            </h2>
            <span class="sound-card-badge">
              {track.data.category.toUpperCase().replace('_', ' ')}
              {track.data.audio?.duration && ` · ${track.data.audio.duration}`}
            </span>
          </div>

          {track.data.location && (
            <p class="sound-card-desc">
              &#128205; {typeof track.data.location === 'object' ? `${track.data.location.name}` : track.data.location}
            </p>
          )}

          {track.data.audio?.src && (
            <div style="margin: 1rem 0;">
              <audio controls src={track.data.audio.src} class="sound-audio-native" preload="none"></audio>
            </div>
          )}

          <div>
            <a href={`/posts/sonidos-${track.id.replace(/\.md$/, '')}/`} class="hero-shortcut-link" style="font-size: 0.85rem;">
              <span>Ficha de grabación & notas</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <footer style="margin-top: 6rem; padding-top: 3rem; border-top: 1px solid var(--border-subtle); text-align: center;">
      <div style="display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; font-size: 0.85rem;">
        <a href={SOCIAL_LINKS.bandcamp} target="_blank" rel="noopener noreferrer" style="color: var(--accent-gold); text-decoration: none;">Bandcamp &rarr;</a>
        <a href={SOCIAL_LINKS.soundcloud} target="_blank" rel="noopener noreferrer" style="color: var(--accent-gold); text-decoration: none;">SoundCloud &rarr;</a>
        <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer" style="color: var(--accent-gold); text-decoration: none;">YouTube &rarr;</a>
      </div>
    </footer>
  </div>
</Layout>
