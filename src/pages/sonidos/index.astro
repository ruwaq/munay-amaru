---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const allSonidos = await getCollection('sonidos', ({ data }) => !data.draft);
allSonidos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout activePage="sounds" title="Sonidos en 432 Hz" locale="es">
  <!-- PÁGINA TEMPORAL: placeholder mientras se construye el diseño nuevo del bosque -->
  <div style="
    min-height: 100vh;
    background: #0c1210;
    color: #dce5df;
    font-family: 'Cormorant Garamond', Georgia, serif;
    padding: 4rem 2rem;
    max-width: 700px;
    margin: 0 auto;
  ">
    <a href="/" style="color: #c4a35a; font-size: 0.85rem; letter-spacing: 0.1em;">← Volver</a>
    <h1 style="font-size: clamp(2rem, 6vw, 3.5rem); margin: 2rem 0 0.5rem; letter-spacing: 0.1em;">
      Sonidos
    </h1>
    <p style="opacity: 0.5; font-style: italic; margin-bottom: 3rem;">432 Hz · Cantos de medicina · Grabaciones de campo</p>
    <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 2rem;">
      {allSonidos.map((track) => (
        <li style="border-bottom: 1px solid #243028; padding-bottom: 1.5rem;">
          <a href={`/posts/sonidos-${track.id.replace(/\.md$/, '')}/`} style="color: #dce5df; text-decoration: none;">
            <div style="font-size: 0.75rem; letter-spacing: 0.15em; color: #c4a35a; margin-bottom: 0.3rem;">
              {track.data.category.toUpperCase().replace('_', ' ')} · {track.data.audio?.duration || ''}
            </div>
            <div style="font-size: 1.4rem;">{track.data.title}</div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
