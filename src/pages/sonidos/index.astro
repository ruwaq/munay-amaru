---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import SamaySanctuary from '../../components/SamaySanctuary.astro';

const allSonidos = await getCollection('sonidos', ({ data }) => !data.draft);
allSonidos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout activePage="sounds" title="Cintas & Sonidos en 432 Hz" locale="es">

  <!-- Cabecera de Registros Sonoros -->
  <div style="margin-bottom: 36px; border-bottom: 1px solid var(--rule); padding-bottom: 18px;">
    <span class="inv-code" style="margin-bottom: 6px;">CINTAS SONORAS &middot; REGISTROS EN 432 Hz</span>
    <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 400; color: var(--ink); line-height: 1.15; margin-top: 4px;">
      Cintas &amp; Sonidos
    </h1>
    <p style="font-family: var(--font-display); font-size: 1.15rem; font-style: italic; color: var(--ink-muted); max-width: 58ch; margin-top: 8px; line-height: 1.65;">
      Afinaciones orgánicas a 432 Hz, paisajes acústicos y grabaciones de campo concebidas como espacios de pausa y escucha atenta.
    </p>
  </div>

  <!-- Círculo Samay interactivo -->
  <SamaySanctuary />

  <!-- Cintas y Registros de Campo -->
  {allSonidos.length > 0 && (
    <section>
      <div style="margin-bottom: 20px; border-bottom: 1px solid var(--rule); padding-bottom: 8px; display: flex; justify-content: space-between; align-items: baseline;">
        <span class="inv-code">CINTAS &middot; REGISTROS DE CAMPO</span>
        <span style="font-size: 0.78rem; color: var(--ink-faint); font-family: var(--font-mono);">{allSonidos.length} registros</span>
      </div>

      <div style="display: grid; grid-template-columns: 1fr; gap: 24px; margin-bottom: 50px;">
        {allSonidos.map((track) => (
          <article class="sanctuary-player">
            <div class="player-header">
              <div>
                <span class="inv-code" style="margin-bottom: 2px;">
                  {track.data.category.toUpperCase().replace('_', ' ')}
                </span>
                <h2 style="font-family: var(--font-display); font-size: 1.55rem; font-weight: 500; margin-top: 2px; line-height: 1.2;">
                  <a href={`/posts/sonidos-${track.id.replace(/\.md$/, '')}/`} style="color: inherit; text-decoration: none;">
                    {track.data.title}
                  </a>
                </h2>
              </div>
              <span class="freq-badge">432 Hz &middot; {track.data.audio?.duration || '03:30'}</span>
            </div>

            {track.data.location && (
              <div style="display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.82rem; color: var(--ink-muted); margin-bottom: 12px;">
                <span>&#128205; {track.data.location.name} {track.data.location.country && `(${track.data.location.country})`}</span>
                {track.data.location.elevation && <span>&#9968;&#65039; {track.data.location.elevation}</span>}
              </div>
            )}

            {track.data.gear && (
              <div style="font-size: 0.78rem; color: var(--ink-faint); font-family: var(--font-mono); margin-bottom: 14px; display: flex; align-items: flex-start; gap: 8px;">
                <span style="flex-shrink: 0;">&#127908;</span>
                <span>{track.data.gear}</span>
              </div>
            )}

            <div style="margin-top: 14px;">
              <audio controls src={track.data.audio?.src} style="width: 100%; height: 38px; filter: sepia(10%);"></audio>
            </div>

            <div style="margin-top: 12px; display: flex; justify-content: flex-end;">
              <a href={`/posts/sonidos-${track.id.replace(/\.md$/, '')}/`} style="font-size: 0.82rem; font-weight: 500; color: var(--ink-primary); text-decoration: underline; text-underline-offset: 3px; min-height: 44px; display: inline-flex; align-items: center;">
                Leer notas de grabación &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

</Layout>
