---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const allViajes = await getCollection('viajes', ({ data }) => !data.draft);
allViajes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allMiradas = await getCollection('miradas', ({ data }) => !data.draft);
allMiradas.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout activePage="gazes" title="Geopoética & Expediciones Nómadas" locale="es">
  <div style="margin-bottom: 40px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 20px;">
    <span class="inv-code" style="margin-bottom: 6px;">SALA DE EXPEDICIONES &middot; EL ARTISTA NÓMADA</span>
    <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 400; color: var(--ink-primary); line-height: 1.15; margin-top: 4px;">
      Geopoética &amp; Diarios de Viaje
    </h1>
    <p style="font-family: var(--font-display); font-size: 1.2rem; font-style: italic; color: var(--ink-muted); max-width: 58ch; margin-top: 8px;">
      Bitácoras de escucha, despojo y afinación del ser con los elementos: la niebla de Rumania, las raíces de Polonia, la luz de Grecia y los Apus de los Andes.
    </p>
  </div>

  <!-- Diarios de viaje geopoéticos -->
  <div style="display: grid; grid-template-columns: 1fr; gap: 32px; margin-bottom: 60px;">
    {allViajes.map((viaje) => (
      <article class="zen-card">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px;">
          <span class="inv-code">
            {viaje.data.location.country ? `${viaje.data.location.country.toUpperCase()}` : 'EXPEDICIÓN'}
            {viaje.data.location.elevation && ` · ${viaje.data.location.elevation}`}
          </span>
          <span style="font-size: 0.78rem; color: var(--ink-faint);">
            {viaje.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
          </span>
        </div>

        <h2 class="zen-title">
          <a href={`/posts/viajes-${viaje.id.replace(/\.md$/, '')}/`}>
            {viaje.data.title}
          </a>
        </h2>

        <p style="font-size: 0.95rem; color: var(--ink-muted); line-height: 1.65; margin-bottom: 16px;">
          📍 <strong>{viaje.data.location.name}</strong> — {viaje.data.journey?.stage || viaje.data.journey?.name || 'Diario de campo'}
        </p>

        {viaje.data.ambientAudio && (
          <div style="margin-bottom: 16px;">
            <audio controls src={viaje.data.ambientAudio.src} style="width: 100%; height: 36px; filter: sepia(10%);"></audio>
          </div>
        )}

        <a href={`/posts/viajes-${viaje.id.replace(/\.md$/, '')}/`} style="font-size: 0.85rem; font-weight: 600; color: var(--ink-primary); text-decoration: underline; text-underline-offset: 3px;">
          Leer crónica de expedición &rarr;
        </a>
      </article>
    ))}
  </div>

  <!-- Galería fotográfica contemplativa -->
  {allMiradas.length > 0 && (
    <section>
      <div style="margin-bottom: 24px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 8px;">
        <span class="inv-code">REGISTRO VISUAL CONTEMPLATIVO</span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
        {allMiradas.map((mirada) => (
          <article class="zen-card">
            <div class="float-mount-frame" style="margin-bottom: 16px; padding: 16px;">
              <img src={mirada.data.photo.src} alt={mirada.data.photo.alt} class="float-artwork" />
            </div>
            <h3 style="font-family: var(--font-display); font-size: 1.3rem; margin-bottom: 6px;">
              {mirada.data.title || 'Instante mineral'}
            </h3>
            <p style="font-size: 0.88rem; color: var(--ink-muted); line-height: 1.5; margin-bottom: 12px;">
              {mirada.data.footnote}
            </p>
            <span style="font-size: 0.75rem; color: var(--ink-faint);">
              📷 {mirada.data.analogDate} {mirada.data.location && `· ${mirada.data.location}`}
            </span>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
