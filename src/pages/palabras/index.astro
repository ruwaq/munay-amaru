---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const allPoemas = await getCollection('poemas', ({ data }) => !data.draft);
allPoemas.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allCuentos = await getCollection('cuentos', ({ data }) => !data.draft);
allCuentos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allPensamientos = await getCollection('pensamientos', ({ data }) => !data.draft);
allPensamientos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout activePage="words" title="Palabras & Papeles Sueltos" locale="es">

  <!-- Cabecera de Papeles Sueltos -->
  <div style="margin-bottom: 36px; border-bottom: 1px solid var(--rule); padding-bottom: 18px;">
    <span class="inv-code" style="margin-bottom: 6px;">PAPELES SUELTOS &middot; VERSOS, RELATOS &amp; APUNTES</span>
    <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 400; color: var(--ink); line-height: 1.15; margin-top: 4px; max-width: 22ch;">
      Palabras &amp; Papeles
    </h1>
    <p style="font-family: var(--font-display); font-size: 1.15rem; font-style: italic; color: var(--ink-muted); max-width: 58ch; margin-top: 8px; line-height: 1.65;">
      Versos, relatos breves y fragmentos de libreta escritos sobre la marcha.
    </p>
    <div style="margin-top: 18px; display: flex; gap: 16px; flex-wrap: wrap; font-family: var(--font-label); font-size: 0.65rem; letter-spacing: 0.16em; color: var(--ink-muted); text-transform: uppercase;">
      <a href="#poemas" style="color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--gold); padding-bottom: 2px;">I — Poemas</a>
      <a href="#cuentos" style="color: inherit; text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 2px;">II — Relatos</a>
      <a href="#aforismos" style="color: inherit; text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 2px;">III — Notas</a>
    </div>
  </div>

  <!-- I. POEMAS -->
  <section id="poemas" style="margin-bottom: 50px;">
    <div style="margin-bottom: 20px; border-bottom: 1px solid var(--rule); padding-bottom: 8px; display: flex; justify-content: space-between; align-items: baseline;">
      <span class="inv-code">I &mdash; POEMAS &middot; VERSOS</span>
      <span style="font-size: 0.78rem; color: var(--ink-faint);">{allPoemas.length} poemas</span>
    </div>
    <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
      {allPoemas.map((poema) => (
        <article class="zen-card" style="border-left: 2px solid var(--accent-gold);">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
            <span class="inv-code" style="margin-bottom: 0;">POEMA</span>
            <span style="font-size: 0.78rem; color: var(--ink-faint);">
              {poema.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
            </span>
          </div>
          <h2 class="zen-title">
            <a href={`/posts/poemas-${poema.id.replace(/\.md$/, '')}/`}>{poema.data.title}</a>
          </h2>
          {poema.data.dedication && (
            <p style="font-family: var(--font-display); font-size: 1.05rem; font-style: italic; color: var(--ink-muted); margin-bottom: 10px; line-height: 1.6;">
              &laquo;{poema.data.dedication}&raquo;
            </p>
          )}
          {poema.data.location && (
            <div style="font-size: 0.8rem; color: var(--ink-faint); margin-bottom: 14px;">
              &#128205; {poema.data.location}
            </div>
          )}
          <a href={`/posts/poemas-${poema.id.replace(/\.md$/, '')}/`} style="font-size: 0.85rem; font-weight: 600; color: var(--ink-primary); text-decoration: underline; text-underline-offset: 3px; min-height: 44px; display: inline-flex; align-items: center;">
            Leer poema &rarr;
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- II. CUENTOS -->
  {allCuentos.length > 0 && (
    <section id="cuentos" style="margin-bottom: 60px;">
      <div style="margin-bottom: 20px; border-bottom: 1px solid var(--rule); padding-bottom: 8px; display: flex; justify-content: space-between; align-items: baseline;">
        <span class="inv-code">II &mdash; RELATOS</span>
        <span style="font-size: 0.78rem; color: var(--ink-faint); font-family: var(--font-mono);">{allCuentos.length} relatos</span>
      </div>
      <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
        {allCuentos.map((cuento) => (
          <article class="zen-card">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
              <span class="inv-code" style="margin-bottom: 0;">RELATO</span>
              <span style="font-size: 0.78rem; color: var(--ink-faint);">
                {cuento.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
              </span>
            </div>
            <h2 class="zen-title">
              <a href={`/posts/cuentos-${cuento.id.replace(/\.md$/, '')}/`}>{cuento.data.title}</a>
            </h2>
            <a href={`/posts/cuentos-${cuento.id.replace(/\.md$/, '')}/`} style="font-size: 0.85rem; font-weight: 500; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; min-height: 44px; display: inline-flex; align-items: center;">
              Leer relato &rarr;
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- III. AFORISMOS -->
  {allPensamientos.length > 0 && (
    <section id="aforismos" style="margin-bottom: 50px;">
      <div style="margin-bottom: 20px; border-bottom: 1px solid var(--rule); padding-bottom: 8px; display: flex; justify-content: space-between; align-items: baseline;">
        <span class="inv-code">III &mdash; NOTAS DE CAMPO &middot; FRAGMENTOS</span>
        <span style="font-size: 0.78rem; color: var(--ink-faint); font-family: var(--font-mono);">{allPensamientos.length} notas</span>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px;">
        {allPensamientos.map((pensamiento) => (
          <article class="zen-card" style="background: var(--bg-card-warm);">
            <span class="inv-code" style="margin-bottom: 8px;">
              {pensamiento.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
            <h3 style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 400; margin-bottom: 8px; line-height: 1.3;">
              <a href={`/posts/pensamientos-${pensamiento.id.replace(/\.md$/, '')}/`} style="color: inherit; text-decoration: none;">
                {pensamiento.data.title || 'Fragmento contemplativo'}
              </a>
            </h3>
            {pensamiento.data.mood && (
              <div style="font-size: 0.78rem; color: var(--ink-muted); margin-top: 8px;">Estado: {pensamiento.data.mood}</div>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

</Layout>
