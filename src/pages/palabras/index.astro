---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const allPoemas = await getCollection('poemas', ({ data }) => !data.draft);
allPoemas.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allCuentos = await getCollection('cuentos', ({ data }) => !data.draft);
allCuentos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allPensamientos = await getCollection('pensamientos', ({ data }) => !data.draft);
allPensamientos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout activePage="words" title="Poética & Filosofía Zen" locale="es">
  <div style="margin-bottom: 40px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 20px;">
    <span class="inv-code" style="margin-bottom: 6px;">ALCOBA LITERARIA &middot; EL VERBO Y EL SILENCIO</span>
    <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 400; color: var(--ink-primary); line-height: 1.15; margin-top: 4px;">
      Poética &amp; Filosofía
    </h1>
    <p style="font-family: var(--font-display); font-size: 1.2rem; font-style: italic; color: var(--ink-muted); max-width: 58ch; margin-top: 8px;">
      Versos mayores, ensayos sobre la lentitud, el principio del Ayni andino y la estética Zen del vacío habitado.
    </p>
  </div>

  <!-- Poemas Mayores -->
  <section style="margin-bottom: 50px;">
    <div style="margin-bottom: 20px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 8px;">
      <span class="inv-code">POEMAS &middot; VERSOS DE RESINIFICACIÓN</span>
    </div>

    <div style="display: grid; grid-template-columns: 1fr; gap: 24px;">
      {allPoemas.map((poema) => (
        <article class="zen-card" style="border-left: 2px solid var(--accent-gold);">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
            <span class="inv-code">POEMA</span>
            <span style="font-size: 0.78rem; color: var(--ink-faint);">
              {poema.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
            </span>
          </div>

          <h2 class="zen-title">
            <a href={`/posts/poemas-${poema.id.replace(/\.md$/, '')}/`}>
              {poema.data.title}
            </a>
          </h2>

          {poema.data.dedication && (
            <p style="font-family: var(--font-display); font-size: 1.05rem; font-style: italic; color: var(--ink-muted); margin-bottom: 12px;">
              «{poema.data.dedication}»
            </p>
          )}

          {poema.data.location && (
            <div style="font-size: 0.8rem; color: var(--ink-faint); margin-bottom: 14px;">
              📍 {poema.data.location}
            </div>
          )}

          <a href={`/posts/poemas-${poema.id.replace(/\.md$/, '')}/`} style="font-size: 0.85rem; font-weight: 600; color: var(--ink-primary); text-decoration: underline; text-underline-offset: 3px;">
            Leer poema &rarr;
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- Pensamientos & Aforismos Zen -->
  {allPensamientos.length > 0 && (
    <section style="margin-bottom: 50px;">
      <div style="margin-bottom: 20px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 8px;">
        <span class="inv-code">AFORISMOS &middot; FRAGMENTOS DE DIARIO</span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        {allPensamientos.map((pensamiento) => (
          <article class="zen-card" style="background: var(--bg-card-warm);">
            <span class="inv-code" style="margin-bottom: 6px;">
              {pensamiento.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
            <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 10px;">
              <a href={`/posts/pensamientos-${pensamiento.id.replace(/\.md$/, '')}/`} style="color: inherit; text-decoration: none;">
                {pensamiento.data.title || 'Fragmento contemplativo'}
              </a>
            </h3>
            {pensamiento.data.mood && (
              <span style="font-size: 0.78rem; color: var(--ink-muted);">Estado: {pensamiento.data.mood}</span>
            )}
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
