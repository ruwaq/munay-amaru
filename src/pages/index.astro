---
import Layout from '../components/Layout.astro';

// Las 12 creaciones de Munay Amaru — datos preservados, diseño nuevo a construir
const creaciones = [
  {
    id: 'spec-001',
    title: 'Munay (Corazón Radiante)',
    categoria: 'Tótem Fundacional · Ayni',
    año: '2026',
    fragmento: 'El amor no es pasividad ni resignación: es fuego creador, presencia incondicional y la voluntad sagrada de estar despiertos.',
    url: '/trazos/',
    tipo: 'visual',
