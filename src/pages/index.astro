    tipo: 'sonido',
    audio: '/audio/ejemplo-voz.mp3',
  },
];
---

<Layout activePage="home" locale="es">
  <!-- PÁGINA TEMPORAL: placeholder limpio mientras se construye el diseño nuevo -->
  <div style="
    min-height: 100vh;
    background: #0c1210;
    color: #dce5df;
    font-family: 'Cormorant Garamond', Georgia, serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
  ">
    <h1 style="font-size: clamp(2rem, 8vw, 5rem); letter-spacing: 0.2em; margin-bottom: 1rem;">
      Munay Amaru
    </h1>
    <p style="opacity: 0.5; font-style: italic; margin-bottom: 3rem;">
      El bosque está creciendo · Diseño en construcción
    </p>
    <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem; max-width: 600px; width: 100%;">
      {creaciones.map((c) => (
        <li>
          <a href={c.url} style="color: #c4a35a; text-decoration: none;">
            {c.title} — <span style="opacity: 0.6; font-size: 0.85em;">{c.categoria}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
