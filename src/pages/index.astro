---
import Layout from '../components/Layout.astro';
import MuseumExhibit from '../components/MuseumExhibit.astro';
import SamaySanctuary from '../components/SamaySanctuary.astro';
import { getCollection } from 'astro:content';

// Obra viva destacada del día
const featuredExhibit = {
  invNumber: 'MS-COL-2024-001 · COLECCIÓN PERMANENTE',
  artist: 'ELIANA COLZANI & MUNAY AMARU',
  title: 'I Am a Tree',
  year: '2024',
  medium: 'Óleo botánico sobre lino natural & paisaje sonoro en 432 Hz',
  dimensions: '60 × 60 cm (Lienzo) · 03:10 min (Audio en bucle)',
  provenance: 'Sesiones y residencia artística en Małopolska, Cracovia (Polonia)',
  concept: '«I Am a Tree» explora la interconectividad subterránea del micelio y la memoria vegetal como arquetipo de arraigo espiritual en el nomadismo. La obra pictórica de Eliana Colzani articula una morfología arbórea donde los tonos ocres y verdes profundos dialogan con la composición acústica de Munay Amaru. Una invitación a disolver el cuerpo individual en la red viva del bosque.',
  credits: 'Obra visual: Eliana Colzani · Composición y guitarras: Munay Amaru · Masterización analógica',
  imageSrc: 'https://f4.bcbits.com/img/a3993646546_2.jpg',
  imageAlt: 'Obra de arte I Am a Tree de Eliana Colzani',
  linkUrl: 'https://munaysounds.bandcamp.com/album/nacer',
  audioSrc: '/audio/ejemplo-voz.mp3'
};

// Últimas 3 entradas de palabras/miradas
const ultimosPoemas = (await getCollection('poemas', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const ultimosViajes = (await getCollection('viajes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
---

<Layout activePage="home" locale="es">

  <!-- Umbral de Bienvenida — Espacio 'Ma' (間) -->
  <section style="text-align: center; margin-bottom: 52px; padding-top: 14px;">
    <span class="inv-code" style="margin-bottom: 10px;">PABELLÓN DIGITAL · RESIDENCIA CONTINUA</span>
    <h1 style="font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, 3.6rem); font-weight: 400; color: var(--ink-primary); line-height: 1.1; margin-bottom: 18px; max-width: 18ch; margin-inline: auto;">
      El Silencio<br/>y la Forma
    </h1>
    <p style="font-family: var(--font-display); font-size: clamp(1.15rem, 2.5vw, 1.35rem); font-style: italic; color: var(--ink-muted); max-width: 52ch; margin: 0 auto 24px; line-height: 1.7;">
      Un santuario contemporáneo donde la música orgánica en 432 Hz, la plástica y la poesía nómada habitan en contemplación.
    </p>
    <!-- Divisor Wabi-Sabi de bienvenida -->
    <div class="wabi-divider" style="margin: 0 auto;">&#9670;</div>
  </section>

  <!-- Obra Viva del Día — SALA I -->
  <section style="margin-bottom: 56px;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 10px;">
      <span style="font-family: var(--font-inscription); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted);">
        Obra en Resonancia
      </span>
      <span class="freq-badge">SALA I · BOTÁNICA</span>
    </div>
    <MuseumExhibit {...featuredExhibit} />
  </section>

  <!-- Aforismo Zen / Principio del Ayni -->
  <section class="zen-card" style="text-align: center; padding: clamp(28px, 5vw, 44px); margin-bottom: 52px; border-left: 2px solid var(--accent-gold);">
    <span class="inv-code" style="margin-bottom: 12px;">PRINCIPIO DEL AYNI · RECIPROCIDAD ANDINA</span>
    <blockquote style="font-family: var(--font-display); font-size: clamp(1.2rem, 3vw, 1.55rem); font-style: italic; color: var(--ink-primary); line-height: 1.6; max-width: 44ch; margin: 0 auto 16px;">
      «El silencio nunca está vacío: es un espacio lleno de presencias que solo se hacen audibles cuando dejamos de empujar el tiempo.»
    </blockquote>
    <cite style="font-family: var(--font-inscription); font-size: 0.72rem; letter-spacing: 0.16em; color: var(--ink-muted); text-transform: uppercase;">
      — Proyecto Tu Silencio! · Munay Amaru
    </cite>
  </section>

  <!-- Recorrido por los Pabellones — Grid de Salas -->
  <section style="margin-bottom: 56px;">
    <div style="margin-bottom: 22px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 10px;">
      <span style="font-family: var(--font-inscription); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted);">
        Salas de Exhibición
      </span>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px;">

      <a href="/tienda/" class="zen-card" style="text-decoration: none; display: block;">
        <span class="zen-overline">SALA DE ARTES PLÁSTICAS</span>
        <h2 class="zen-title" style="font-size: 1.5rem;">Galería de Obras</h2>
        <p style="font-size: 0.95rem; color: var(--ink-muted); line-height: 1.6; margin-bottom: 0;">
          Exposiciones de <strong>Eliana Colzani</strong>, <strong>Jimena Vílchez</strong> y <strong>@gastipuray</strong> en diálogo con los álbumes.
        </p>
      </a>

      <a href="/sonidos/" class="zen-card" style="text-decoration: none; display: block;">
        <span class="zen-overline">CÁMARA ACÚSTICA 432 Hz</span>
        <h2 class="zen-title" style="font-size: 1.5rem;">Pabellón Sonoro</h2>
        <p style="font-size: 0.95rem; color: var(--ink-muted); line-height: 1.6; margin-bottom: 0;">
          Sound journeys y meditación: <em>Piedras al Mar</em>, <em>Nacer</em>, <em>Allinllachu</em>, <em>Luce di Alba</em>.
        </p>
      </a>

      <a href="/miradas/" class="zen-card" style="text-decoration: none; display: block;">
        <span class="zen-overline">EXPEDICIONES Y BITÁCORAS</span>
        <h2 class="zen-title" style="font-size: 1.5rem;">Geopoética Nómada</h2>
        <p style="font-size: 0.95rem; color: var(--ink-muted); line-height: 1.6; margin-bottom: 0;">
          Cuadernos de viaje espiritual: la niebla de Rumania, los bosques de Polonia, la luz de Grecia y los Andes.
        </p>
      </a>

      <a href="/palabras/" class="zen-card" style="text-decoration: none; display: block;">
        <span class="zen-overline">ALCOBA LITERARIA</span>
        <h2 class="zen-title" style="font-size: 1.5rem;">Poética &amp; Filosofía</h2>
        <p style="font-size: 0.95rem; color: var(--ink-muted); line-height: 1.6; margin-bottom: 0;">
          Versos mayores y ensayos sobre la lentitud, el Ayni andino y la estética Zen del vacío.
        </p>
      </a>
    </div>
  </section>

  <!-- Últimas entradas del blog literario -->
  {ultimosPoemas.length > 0 && (
    <section style="margin-bottom: 52px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 10px;">
        <span class="inv-code" style="margin-bottom: 0;">ÚLTIMAS OBRAS LITERARIAS</span>
        <a href="/palabras/" style="font-size: 0.8rem; color: var(--ink-muted); text-decoration: none; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center;">Ver todo &rarr;</a>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
        {ultimosPoemas.map(poema => (
          <article class="zen-card" style="border-left: 2px solid var(--accent-gold); margin-bottom: 0;">
            <span class="inv-code" style="margin-bottom: 4px;">POEMA · {poema.data.date.getFullYear()}</span>
            <h3 class="zen-title" style="font-size: 1.4rem; margin-bottom: 6px;">
              <a href={`/posts/poemas-${poema.id.replace(/\.md$/, '')}/`}>{poema.data.title}</a>
            </h3>
            {poema.data.dedication && (
              <p style="font-family: var(--font-display); font-size: 0.95rem; font-style: italic; color: var(--ink-muted);">
                &laquo;{poema.data.dedication}&raquo;
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Círculo Samay — Respiración del Santuario -->
  <SamaySanctuary />

  <!-- Últimos viajes -->
  {ultimosViajes.length > 0 && (
    <section style="margin-bottom: 40px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; border-bottom: 1px solid var(--border-hairline); padding-bottom: 10px;">
        <span class="inv-code" style="margin-bottom: 0;">EXPEDICIONES RECIENTES</span>
        <a href="/miradas/" style="font-size: 0.8rem; color: var(--ink-muted); text-decoration: none; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center;">Ver atlas &rarr;</a>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
        {ultimosViajes.map(viaje => (
          <article class="zen-card" style="margin-bottom: 0;">
            <span class="inv-code" style="margin-bottom: 4px;">
              {viaje.data.location.country?.toUpperCase() || 'EXPEDICIÓN'} · {viaje.data.date.getFullYear()}
            </span>
            <h3 class="zen-title" style="font-size: 1.4rem; margin-bottom: 6px;">
              <a href={`/posts/viajes-${viaje.id.replace(/\.md$/, '')}/`}>{viaje.data.title}</a>
            </h3>
            <p style="font-size: 0.88rem; color: var(--ink-muted);">&#128205; {viaje.data.location.name}</p>
          </article>
        ))}
      </div>
    </section>
  )}

</Layout>
