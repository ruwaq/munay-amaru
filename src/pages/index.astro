---
import Layout from '../components/Layout.astro';
import { getCollection } from 'astro:content';

// 1. Poemas recientes
const ultimosPoemas = (await getCollection('poemas', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

// 2. Viajes / Bitácoras
const ultimosViajes = (await getCollection('viajes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

// 3. Sonidos recientes
const ultimosSonidos = (await getCollection('sonidos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

// 4. Miradas analógicas
const allMiradas = await getCollection('miradas', ({ data }) => !data.draft);
const latestMirada = allMiradas.length > 0 ? allMiradas[0] : null;

// 5. Pensamientos nocturnos / Terminal
const allPensamientos = await getCollection('pensamientos', ({ data }) => !data.draft);
const latestPensamiento = allPensamientos.length > 0 ? allPensamientos[0] : null;
---

<Layout activePage="home" locale="es">

  <!-- Pliego Central de Gaceta en 3 Columnas Asimétricas -->
  <div class="gazette-grid">

    <!-- COLUMNA IZQUIERDA: NOTAS DE CAMPO & TERMINAL -->
    <aside class="gazette-col">
      <div class="col-header">
        <span>NOTAS DE CAMPO</span>
        <span>01</span>
      </div>

      <!-- Recorte de Terminal escrito en Termux -->
      <div class="terminal-clipping">
        <div class="terminal-header">
          <span class="terminal-meta-tag">TERMINAL</span>
          <span>{latestPensamiento?.data.weather?.toUpperCase() || '23:18 · LLUVIA'}</span>
        </div>
        <p style="margin-bottom: 10px;">
          Escribir en una pantalla pequeña obliga a pensar con frases más cortas, casi telegráficas. Hay algo monacal en este cursor parpadeando sobre el fondo negro mientras afuera cae la lluvia sobre el patio.
        </p>
        <p style="margin-bottom: 8px; font-style: italic; color: var(--ink-muted);">
          El dispositivo cambia; el gesto, no.
        </p>
        <div style="font-size: 0.65rem; color: var(--gold); border-top: 1px dashed var(--rule); padding-top: 6px; margin-top: 8px; display: flex; justify-content: space-between;">
          <span>&gt; {latestPensamiento?.data.device || 'TERMUX / MÓVIL'}</span>
          <span>AGOSTO 2026</span>
        </div>
      </div>

      <!-- Aforismo sin etiqueta de marketing -->
      <div class="marginal-note">
        «El silencio nunca está vacío: es un espacio lleno de presencias que solo se hacen audibles cuando dejamos de empujar el tiempo.»
        <span class="marginal-cite">— Principio del Ayni &middot; Reciprocidad</span>
      </div>

      <!-- Lámina Analógica / Polaroids -->
      {latestMirada && (
        <div style="margin-top: 16px; border-top: 1px solid var(--rule); padding-top: 14px;">
          <span style="font-family: var(--font-label); font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-muted); display: block; margin-bottom: 8px;">
            LÁMINA ANALÓGICA
          </span>
          <img
            src={latestMirada.data.photo.src}
            alt={latestMirada.data.photo.alt}
            style="width: 100%; border: 1px solid var(--rule); padding: 3px; background: var(--bg); filter: grayscale(70%) sepia(20%); display: block; margin-bottom: 6px;"
          />
          <p style="font-size: 0.78rem; font-style: italic; color: var(--ink-muted); line-height: 1.4; margin: 0;">
            {latestMirada.data.footnote}
            {latestMirada.data.location && (
              <span style="display: block; font-family: var(--font-mono); font-size: 0.68rem; margin-top: 2px;">
                &#128205; {latestMirada.data.location}
              </span>
            )}
          </p>
        </div>
      )}
    </aside>

    <!-- COLUMNA CENTRAL: PLIEGO PRINCIPAL / OBRA VISUAL -->
    <article class="gazette-col">
      <div class="col-header">
        <span>PLIEGO PRINCIPAL</span>
        <span>MAŁOPOLSKA / CRACOVIA</span>
      </div>

      <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 400; color: var(--ink); line-height: 1.15; margin-bottom: 6px;">
        I Am a Tree
      </h2>
      <p style="font-family: var(--font-display); font-size: 1rem; font-style: italic; color: var(--ink-muted); margin-bottom: 14px;">
        Óleo botánico sobre lino natural & paisaje sonoro en 432 Hz &middot; Eliana Colzani & Munay Amaru
      </p>

      <!-- Grabado Litográfico de Imprenta -->
      <a href="https://munaysounds.bandcamp.com/album/nacer" target="_blank" rel="noopener noreferrer" style="text-decoration: none; display: block;">
        <img
          src="https://f4.bcbits.com/img/a3993646546_2.jpg"
          alt="I Am a Tree — Obra botánica sobre lino por Eliana Colzani"
          class="newspaper-engraving"
        />
      </a>
      <p class="engraving-caption">
        Fig. 1 — «I Am a Tree» (60 &times; 60 cm). Óleo botánico sobre lino por Eliana Colzani. Resonancia acústica en 432 Hz.
      </p>

      <!-- Texto de plomo en 2 columnas con capitular -->
      <div class="newspaper-columns lead-dropcap">
        <p>
          La interconectividad subterránea del micelio y la memoria vegetal como arquetipo de arraigo espiritual en el nomadismo. La materia vegetal articula una morfología donde los tonos ocres y verdes dialogan con la cuerda acústica.
        </p>
        <p>
          Una invitación a disolver la prisa individual en la red viva del bosque. No hay pretensión de artificio: solo madera tensada, pigmento vegetal sobre tela de lino y la vibración en 432 Hz grabada en cinta analógica. Quien mira y escucha completa la forma en su propio silencio.
        </p>
      </div>

      <div style="margin-top: 20px; border-top: 1px solid var(--rule); padding-top: 12px; display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem;">
        <span style="font-family: var(--font-mono); color: var(--ink-muted); font-size: 0.7rem;">REF: MS-TRA-2024-001</span>
        <a href="/trazos/" style="color: var(--ink); text-decoration: underline; text-underline-offset: 3px; font-weight: 500;">
          Abrir cuaderno de trazos &rarr;
        </a>
      </div>
    </article>

    <!-- COLUMNA DERECHA: REGISTRO SONORO & SKILLS -->
    <aside class="gazette-col">
      <div class="col-header">
        <span>CINTAS SONORAS</span>
        <span>432 Hz</span>
      </div>

      <!-- Reproductor compacto de audio -->
      <div class="gazette-audio-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <span style="font-family: var(--font-label); font-size: 0.58rem; letter-spacing: 0.16em; color: var(--gold); text-transform: uppercase;">
            CINTA DIRECTA
          </span>
          <span class="freq-badge">432 Hz</span>
        </div>
        <h3 class="gazette-audio-title">Piedras al Mar</h3>
        <p class="gazette-audio-subtitle">Guitarras orgánicas y resonancia &middot; 03:10 min</p>
        <audio controls preload="none" style="width: 100%; height: 38px;">
          <source src="/audio/ejemplo-voz.mp3" type="audio/mpeg" />
        </audio>
      </div>

      <!-- Lista de sonidos recientes -->
      <div style="margin-bottom: 20px;">
        <span style="font-family: var(--font-label); font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-muted); display: block; margin-bottom: 10px; border-bottom: 1px solid var(--rule); padding-bottom: 4px;">
          GRABACIONES RECIENTES
        </span>
        <ul style="list-style: none; font-size: 0.86rem; line-height: 1.8;">
          {ultimosSonidos.map(s => (
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dashed var(--rule); padding: 4px 0;">
              <a href={`/posts/sonidos-${s.id.replace(/\.md$/, '')}/`} style="color: var(--ink); text-decoration: none;">
                {s.data.title}
              </a>
              <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-muted);">
                {s.data.audio.duration || '432Hz'}
              </span>
            </li>
          ))}
        </ul>
        <a href="/sonidos/" style="display: inline-block; font-size: 0.76rem; color: var(--ink-muted); text-decoration: underline; margin-top: 8px;">
          Escuchar todas las cintas &rarr;
        </a>
      </div>

      <!-- Pausa Samay sutil al pie de columna -->
      <div style="border-top: 1px solid var(--rule); padding-top: 14px; text-align: center; margin-top: auto;">
        <span style="font-family: var(--font-label); font-size: 0.56rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); display: block; margin-bottom: 4px;">
          PAUSA RESPIRATORIA
        </span>
        <div class="samay-circle" style="width: 50px; height: 50px; margin: 6px auto;">
          <span style="font-family: var(--font-label); font-size: 0.48rem; letter-spacing: 0.08em; color: var(--gold);">SAMAY</span>
        </div>
        <p style="font-size: 0.72rem; font-style: italic; color: var(--ink-muted); margin: 0;">
          4s inhala &middot; 4s retén &middot; 6s exhala &middot; 2s pausa
        </p>
      </div>
    </aside>

  </div>

  <!-- BANDA INFERIOR: DESPACHOS DE VIAJE Y PAPELES SUELTOS -->
  <div class="dispatch-strip">
    {ultimosViajes.map(viaje => (
      <a href={`/posts/viajes-${viaje.id.replace(/\.md$/, '')}/`} class="dispatch-card">
        <span class="dispatch-meta">
          &#128205; {viaje.data.location.country?.toUpperCase() || 'DESPACHO'} &middot; {viaje.data.date.getFullYear()}
        </span>
        <h3 class="dispatch-title">{viaje.data.title}</h3>
        <p class="dispatch-snippet">
          {viaje.data.location.name}. Bitácora de ruta, niebla y memoria.
        </p>
      </a>
    ))}

    {ultimosPoemas.map(poema => (
      <a href={`/posts/poemas-${poema.id.replace(/\.md$/, '')}/`} class="dispatch-card">
        <span class="dispatch-meta">
          &#9997; PALABRAS &middot; {poema.data.date.getFullYear()}
        </span>
        <h3 class="dispatch-title">{poema.data.title}</h3>
        <p class="dispatch-snippet" style="font-style: italic;">
          {poema.data.dedication ? `«${poema.data.dedication}»` : 'Lectura de papel suelto.'}
        </p>
      </a>
    ))}
  </div>

</Layout>
