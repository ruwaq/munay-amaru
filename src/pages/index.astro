    tipo: 'sonido',
    audio: '/audio/ejemplo-voz.mp3',
  },
  {
    id: 'spec-008',
    title: 'Pachamamita',
    categoria: 'Devocional Andino · Charango & Ronroco',
    año: '2026',
    fragmento: 'Agüita clara que bajas cantando del barranco, llévate las penas del caminante, déjanos la costumbre sagrada de dar las gracias.',
    url: '/posts/sonidos-pachamamita/',
    tipo: 'sonido',
    audio: '/audio/ejemplo-voz.mp3',
  },
