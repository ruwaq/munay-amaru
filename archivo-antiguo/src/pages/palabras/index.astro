---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const allPoemas = await getCollection('poemas', ({ data }) => !data.draft);
allPoemas.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allCuentos = await getCollection('cuentos', ({ data }) => !data.draft);
allCuentos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allPensamientos = await getCollection('pensamientos', ({ data }) => !data.draft);
allPensamientos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout activePage="words" title="Palabras & Papeles Sueltos" locale="es">
  <div class="page-container">
    <a href="/" class="back-link">&larr; Volver al inicio</a>

    <header class="page-header">
      <span class="section-eyebrow">Versos, Relatos & Cuadernos</span>
      <h1 class="page-title">Palabras & Papeles</h1>
      <p class="page-description">
        Fábulas ecológicas de micelio, sátira existencial y notas de libreta escritas sobre la marcha.
      </p>

      <nav style="display: flex; gap: 1.5rem; margin-top: 1.8rem; font-size: 0.9rem;" aria-label="Secciones de textos">
        <a href="#poemas" class="hero-shortcut-link">Poemas ({allPoemas.length})</a>
        <a href="#cuentos" class="hero-shortcut-link">Relatos ({allCuentos.length})</a>
        <a href="#pensamientos" class="hero-shortcut-link">Pensamientos ({allPensamientos.length})</a>
      </nav>
    </header>

    <!-- I. POEMAS -->
    <section id="poemas" class="home-section">
      <div class="home-section-header">
        <h2 class="home-section-title">Poemas & Versos</h2>
        <span class="home-section-more">{allPoemas.length} poemas</span>
      </div>

      <div class="item-list">
        {allPoemas.map((poema) => (
          <article>
            <a href={`/posts/poemas-${poema.id.replace(/\.md$/, '')}/`} class="item-entry">
              <div class="item-meta">
                <span class="item-meta-category">Poema</span>
                <span>&middot;</span>
                <time datetime={poema.data.date.toISOString()}>
                  {poema.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
                </time>
                {poema.data.location && <span>&middot; {poema.data.location}</span>}
              </div>
              <h3 class="item-title">{poema.data.title}</h3>
              {poema.data.dedication && (
                <p class="item-summary" style="font-style: italic; margin-bottom: 0.4rem;">
                  &laquo;{poema.data.dedication}&raquo;
                </p>
              )}
              <div class="item-arrow">
                <span>Leer poema</span>
                <span aria-hidden="true">&rarr;</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- II. CUENTOS -->
    {allCuentos.length > 0 && (
      <section id="cuentos" class="home-section">
        <div class="home-section-header">
          <h2 class="home-section-title">Relatos & Fábulas</h2>
          <span class="home-section-more">{allCuentos.length} relatos</span>
        </div>

        <div class="item-list">
          {allCuentos.map((cuento) => (
            <article>
              <a href={`/posts/cuentos-${cuento.id.replace(/\.md$/, '')}/`} class="item-entry">
                <div class="item-meta">
                  <span class="item-meta-category">Relato</span>
                  <span>&middot;</span>
                  <time datetime={cuento.data.date.toISOString()}>
                    {cuento.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
                  </time>
                  {cuento.data.series && <span>&middot; {cuento.data.series.name}</span>}
                </div>
                <h3 class="item-title">{cuento.data.title}</h3>
                {cuento.data.summary && (
                  <p class="item-summary">{cuento.data.summary}</p>
                )}
                <div class="item-arrow">
                  <span>Leer relato</span>
                  <span aria-hidden="true">&rarr;</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- III. PENSAMIENTOS -->
    {allPensamientos.length > 0 && (
      <section id="pensamientos" class="home-section">
        <div class="home-section-header">
          <h2 class="home-section-title">Filosofía & Notas de Libreta</h2>
          <span class="home-section-more">{allPensamientos.length} notas</span>
        </div>

        <div class="item-list">
          {allPensamientos.map((pensamiento) => (
            <article>
              <a href={`/posts/pensamientos-${pensamiento.id.replace(/\.md$/, '')}/`} class="item-entry">
                <div class="item-meta">
                  <span class="item-meta-category">Cuaderno</span>
                  <span>&middot;</span>
                  <time datetime={pensamiento.data.date.toISOString()}>
                    {pensamiento.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  {pensamiento.data.mood && <span>&middot; {pensamiento.data.mood}</span>}
                </div>
                <h3 class="item-title">{pensamiento.data.title || 'Fragmento contemplativo'}</h3>
                <p class="item-summary">
                  {(pensamiento.body || '').slice(0, 180).trim()}...
                </p>
                <div class="item-arrow">
                  <span>Leer nota</span>
                  <span aria-hidden="true">&rarr;</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
