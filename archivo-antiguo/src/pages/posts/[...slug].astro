---
import Layout from '../../components/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const collections = ['poemas', 'cuentos', 'pensamientos', 'miradas', 'viajes', 'sonidos'] as const;
  const paths = [];
  for (const colName of collections) {
    const entries = await getCollection(colName, ({ data }) => !data.draft);
    entries.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());
    for (let i = 0; i < entries.length; i++) {
      const entry = entries[i];
      const prev = i > 0 ? entries[i - 1] : null;
      const next = i < entries.length - 1 ? entries[i + 1] : null;
      const cleanSlug = entry.id.replace(/\.md$/, '');
      paths.push({
        params: { slug: `${colName}-${cleanSlug}` },
        props: { entry, collectionName: colName, prevEntry: prev, nextEntry: next },
      });
    }
  }
  return paths;
}

type ValidCollection = 'poemas' | 'cuentos' | 'pensamientos' | 'miradas' | 'viajes' | 'sonidos';
export interface Props {
  entry: CollectionEntry<ValidCollection>;
  collectionName: ValidCollection;
  prevEntry: CollectionEntry<ValidCollection> | null;
  nextEntry: CollectionEntry<ValidCollection> | null;
}

interface EntryDataCommon {
  title?: string;
  date: Date;
  draft?: boolean;
  dedication?: string;
  location?: string | { name: string; country?: string; elevation?: string };
  photo?: { src: string; alt?: string };
  footnote?: string;
  audio?: { src: string; duration?: string };
  ambientAudio?: { src: string; duration?: string };
  lang?: string;
  tags?: string[];
}

const { entry, collectionName, prevEntry, nextEntry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data as EntryDataCommon;

const wordCount = (entry.body || '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));

const categoryMeta: Record<string, { label: string; backUrl: string; backLabel: string }> = {
  poemas:       { label: 'Poema · Versos de Silencio',         backUrl: '/palabras/#poemas',       backLabel: 'Palabras & Poemas' },
  cuentos:      { label: 'Relato & Fábulas del Bosque',        backUrl: '/palabras/#cuentos',      backLabel: 'Palabras & Relatos' },
  pensamientos: { label: 'Cuaderno de Campo & Filosofía',      backUrl: '/palabras/#pensamientos', backLabel: 'Palabras & Filosofía' },
  miradas:      { label: 'Registro Visual · Instante Mineral', backUrl: '/miradas/#miradas',       backLabel: 'Rutas & Miradas' },
  viajes:       { label: 'Cuaderno de Ruta · Expedición',      backUrl: '/miradas/#viajes',        backLabel: 'Rutas & Miradas' },
  sonidos:      { label: 'Paisaje Sonoro & Canto en 432 Hz',   backUrl: '/sonidos/',               backLabel: 'Sonidos del Bosque' },
};

const meta = categoryMeta[collectionName] || { label: 'Creación', backUrl: '/', backLabel: 'Inicio' };
const isPoem = collectionName === 'poemas';
const activePageMap: Record<string, string> = {
  sonidos: 'sounds', poemas: 'words', cuentos: 'words', pensamientos: 'words',
  viajes: 'gazes', miradas: 'gazes',
};
---

<Layout title={data.title || 'Creación'} activePage={activePageMap[collectionName] || 'home'} locale={(data.lang === 'en' ? 'en' : 'es') as import('../../utils/i18n').Locale}>
  <div class="page-container">
    <!-- Enlace de regreso -->
    <a href={meta.backUrl} class="back-link">
      &larr; Volver a {meta.backLabel}
    </a>

    <article class="reading-article">
      <!-- Cabecera de la obra -->
      <header class="reading-header">
        <span class="section-eyebrow">{meta.label}</span>
        <h1 class="reading-title">{data.title || 'Sin Título'}</h1>

        {data.dedication && (
          <p class="reading-dedication">
            &laquo;{data.dedication}&raquo;
          </p>
        )}

        <div class="reading-meta">
          {data.date && (
            <time datetime={new Date(data.date).toISOString()}>
              {new Date(data.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          )}
          {!isPoem && <span>&middot; {readingMinutes} min de lectura lenta</span>}
          {data.location && (
            <span>&middot; &#128205; {typeof data.location === 'object' ? `${data.location.name}${data.location.country ? ', ' + data.location.country : ''}` : data.location}</span>
          )}
          {typeof data.location === 'object' && data.location?.elevation && (
            <span>&middot; &#9968;&#65039; {data.location.elevation}</span>
          )}
        </div>
      </header>

      <!-- Fotografía analógica si existe imagen -->
      {data.photo && (
        <figure class="reading-figure">
          <img src={data.photo.src} alt={data.photo.alt || data.title} loading="lazy" decoding="async" />
          {data.footnote && (
            <figcaption>{data.footnote}</figcaption>
          )}
        </figure>
      )}

      <!-- Reproductor de audio integrado para piezas sonoras -->
      {(data.audio || data.ambientAudio) && (
        <div class="sound-card" style="margin: 2.5rem 0;">
          <div class="sound-card-header">
            <span class="sound-card-badge">432 Hz &middot; Resonancia Acústica</span>
            <span style="font-size: 0.8rem; color: var(--text-muted);">
              {(data.audio || data.ambientAudio)?.duration || 'Grabación viva'}
            </span>
          </div>
          <audio controls src={(data.audio || data.ambientAudio)?.src} class="sound-audio-native" preload="none"></audio>
        </div>
      )}

      <!-- Cuerpo del texto / Prosa o Poema -->
      <div class={isPoem ? 'poem-body' : 'prose-body'}>
        <Content />
      </div>

      <!-- Navegación entre obras (anterior / siguiente) -->
      <nav aria-label="Navegación entre creaciones" class="post-navigation">
        <div>
          {prevEntry && (
            <a href={`/posts/${collectionName}-${prevEntry.id.replace(/\.md$/, '')}/`} class="post-nav-item">
              <span class="post-nav-label">&larr; Anterior</span>
              <h4 class="post-nav-title">{prevEntry.data.title || 'Anterior'}</h4>
            </a>
          )}
        </div>
        <div style="text-align: right;">
          {nextEntry && (
            <a href={`/posts/${collectionName}-${nextEntry.id.replace(/\.md$/, '')}/`} class="post-nav-item">
              <span class="post-nav-label">Siguiente &rarr;</span>
              <h4 class="post-nav-title">{nextEntry.data.title || 'Siguiente'}</h4>
            </a>
          )}
        </div>
      </nav>
    </article>
  </div>
</Layout>
