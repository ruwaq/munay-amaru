---
import Layout from '../components/Layout.astro';
import { getCollection } from 'astro:content';

// 1. Último pensamiento / nota de libreta
const allPensamientos = await getCollection('pensamientos', ({ data }) => !data.draft);
allPensamientos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const ultimoPensamiento = allPensamientos[0];

// 2. Pieza sonora destacada
const allSonidos = await getCollection('sonidos', ({ data }) => !data.draft);
allSonidos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const sonidoDestacado = allSonidos.find(s => s.id.includes('i-am-a-tree')) || allSonidos[0];

// 3. Cuaderno de ruta o expedición reciente
const allViajes = await getCollection('viajes', ({ data }) => !data.draft);
allViajes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const ultimoViaje = allViajes[0];

// 4. Obra destacada de Trazos
const obraDestacada = {
  title: 'Munay (Corazón Radiante)',
  categoria: 'Pastel al óleo & Voluntad · 2026',
  fragmento: 'Silueta iluminada con corazón ardiente. La voluntad afectiva que no evade el dolor del mundo.',
  imagen: '/images/cuaderno/munay-corazon-pastel-restaurado.jpg',
  url: '/trazos/#munay',
};
---

<Layout activePage="home" locale="es">
  <div class="page-container">
    
    <!-- Hero Minimalista -->
    <header class="hero-minimal">
      <span class="hero-tag">Diario de Vida &middot; Archivo Abierto</span>
      <h1 class="hero-heading">Munay Amaru</h1>
      <p class="hero-lead">
        Registros de existencia: notas de libreta, grabaciones templadas a 432 Hz, pigmentos sobre papel y caminos entre los Andes, el Báltico y el Mediterráneo.
      </p>

      <nav class="hero-shortcuts" aria-label="Secciones principales">
        <a href="/trazos/" class="hero-shortcut-link">
          <span>Trazos</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/sonidos/" class="hero-shortcut-link">
          <span>Sonidos</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/palabras/" class="hero-shortcut-link">
          <span>Palabras</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/miradas/" class="hero-shortcut-link">
          <span>Miradas</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/sobre/" class="hero-shortcut-link">
          <span>Sobre</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </nav>
    </header>

    <!-- Sección: Último Pensamiento / Nota de Campo -->
    {ultimoPensamiento && (
      <section class="home-section">
        <div class="home-section-header">
          <h2 class="home-section-title">Nota de Campo</h2>
          <a href="/palabras/#pensamientos" class="home-section-more">Ver todas &rarr;</a>
        </div>

        <article>
          <a href={`/posts/pensamientos-${ultimoPensamiento.id.replace(/\.md$/, '')}/`} class="item-entry">
            <div class="item-meta">
              <span class="item-meta-category">Cuaderno de Terminal</span>
              <span>&middot;</span>
              <time datetime={ultimoPensamiento.data.date.toISOString()}>
                {ultimoPensamiento.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              {ultimoPensamiento.data.mood && (
                <>
                  <span>&middot;</span>
                  <span>{ultimoPensamiento.data.mood}</span>
                </>
              )}
            </div>
            <h3 class="item-title">
              {ultimoPensamiento.data.title || 'Fragmento contemplativo'}
            </h3>
            <p class="item-summary">
              {(ultimoPensamiento.body || '').slice(0, 220).trim()}...
            </p>
            <div class="item-arrow">
              <span>Leer nota completa</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </a>
        </article>
      </section>
    )}

    <!-- Sección: Lámina & Trazo Destacado -->
    <section class="home-section">
      <div class="home-section-header">
        <h2 class="home-section-title">Lámina & Materia</h2>
        <a href="/trazos/" class="home-section-more">Ver galería &rarr;</a>
      </div>

      <article>
        <a href={obraDestacada.url} class="item-entry" style="border-bottom: none; padding-bottom: 0;">
          <div class="plate-figure" style="max-height: 400px; aspect-ratio: 16/10; margin-bottom: 1.2rem;">
            <img
              src={obraDestacada.imagen}
              alt={obraDestacada.title}
              class="plate-img"
              loading="lazy"
            />
          </div>
          <div class="item-meta">
            <span class="item-meta-category">{obraDestacada.categoria}</span>
          </div>
          <h3 class="item-title">{obraDestacada.title}</h3>
          <p class="item-summary">{obraDestacada.fragmento}</p>
          <div class="item-arrow">
            <span>Ver lámina</span>
            <span aria-hidden="true">&rarr;</span>
          </div>
        </a>
      </article>
    </section>

    <!-- Sección: Resonancia Sonora 432 Hz -->
    {sonidoDestacado && (
      <section class="home-section">
        <div class="home-section-header">
          <h2 class="home-section-title">Resonancia Sonora (432 Hz)</h2>
          <a href="/sonidos/" class="home-section-more">Ver registros &rarr;</a>
        </div>

        <div class="sound-card">
          <div class="sound-card-header">
            <h3 class="sound-card-title">{sonidoDestacado.data.title}</h3>
            <span class="sound-card-badge">
              432 Hz &middot; {sonidoDestacado.data.audio?.duration || 'Grabación viva'}
            </span>
          </div>
          <p class="sound-card-desc">
            {sonidoDestacado.data.category.toUpperCase().replace('_', ' ')}
            {sonidoDestacado.data.location && (
              <span> &middot; {typeof sonidoDestacado.data.location === 'object' ? sonidoDestacado.data.location.name : sonidoDestacado.data.location}</span>
            )}
          </p>

          {sonidoDestacado.data.audio?.src ? (
            <audio controls src={sonidoDestacado.data.audio.src} class="sound-audio-native" preload="none"></audio>
          ) : (
            <audio controls src="/audio/432hz-bosque.wav" class="sound-audio-native" preload="none"></audio>
          )}

          <div style="margin-top: 1rem;">
            <a href={`/posts/sonidos-${sonidoDestacado.id.replace(/\.md$/, '')}/`} class="hero-shortcut-link" style="font-size: 0.85rem;">
              <span>Ficha y notas de la pieza</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Sección: Cuaderno de Ruta -->
    {ultimoViaje && (
      <section class="home-section" style="margin-bottom: 2rem;">
        <div class="home-section-header">
          <h2 class="home-section-title">Cuaderno de Ruta</h2>
          <a href="/miradas/" class="home-section-more">Ver crónicas &rarr;</a>
        </div>

        <article>
          <a href={`/posts/viajes-${ultimoViaje.id.replace(/\.md$/, '')}/`} class="item-entry" style="border-bottom: none;">
            <div class="item-meta">
              <span class="item-meta-category">
                {ultimoViaje.data.location.country ? ultimoViaje.data.location.country.toUpperCase() : 'EXPEDICIÓN'}
              </span>
              <span>&middot;</span>
              <time datetime={ultimoViaje.data.date.toISOString()}>
                {ultimoViaje.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long' })}
              </time>
              <span>&middot;</span>
              <span>{ultimoViaje.data.location.name}</span>
            </div>
            <h3 class="item-title">{ultimoViaje.data.title}</h3>
            <p class="item-summary">
              {(ultimoViaje.body || '').slice(0, 190).trim()}...
            </p>
            <div class="item-arrow">
              <span>Leer crónica de viaje</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </a>
        </article>
      </section>
    )}

  </div>
</Layout>
