---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const allViajes = await getCollection('viajes', ({ data }) => !data.draft);
allViajes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allMiradas = await getCollection('miradas', ({ data }) => !data.draft);
allMiradas.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout activePage="gazes" title="Rutas & Cuadernos de Campo" locale="es">
  <div class="page-container-wide">
    <a href="/" class="back-link">&larr; Volver al inicio</a>

    <header class="page-header">
      <span class="section-eyebrow">Bitácoras de Ruta & Polaroids</span>
      <h1 class="page-title">Rutas & Miradas</h1>
      <p class="page-description">
        Coordenadas, cuadernos de viaje y registros analógicos: la niebla de Rumania, los bosques de Polonia, la costa de Grecia y los Andes.
      </p>

      <nav style="display: flex; gap: 1.5rem; margin-top: 1.8rem; font-size: 0.9rem;" aria-label="Secciones de rutas y miradas">
        <a href="#viajes" class="hero-shortcut-link">Cuadernos de Ruta ({allViajes.length})</a>
        <a href="#miradas" class="hero-shortcut-link">Registros Analógicos ({allMiradas.length})</a>
      </nav>
    </header>

    <!-- Diarios de viaje y expediciones -->
    {allViajes.length > 0 && (
      <section id="viajes" class="home-section">
        <div class="home-section-header">
          <h2 class="home-section-title">Cuadernos de Ruta</h2>
          <span class="home-section-more">{allViajes.length} expediciones</span>
        </div>

        <div class="item-list">
          {allViajes.map((viaje) => (
            <article>
              <a href={`/posts/viajes-${viaje.id.replace(/\.md$/, '')}/`} class="item-entry">
                <div class="item-meta">
                  <span class="item-meta-category">
                    {viaje.data.location.country ? viaje.data.location.country.toUpperCase() : 'EXPEDICIÓN'}
                  </span>
                  <span>&middot;</span>
                  <time datetime={viaje.data.date.toISOString()}>
                    {viaje.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long' })}
                  </time>
                  <span>&middot;</span>
                  <span>{viaje.data.location.name}</span>
                  {viaje.data.location.elevation && <span>&middot; &#9968;&#65039; {viaje.data.location.elevation}</span>}
                </div>
                <h3 class="item-title">{viaje.data.title}</h3>
                <p class="item-summary">
                  {(viaje.body || '').slice(0, 200).trim()}...
                </p>
                <div class="item-arrow">
                  <span>Leer crónica de expedición</span>
                  <span aria-hidden="true">&rarr;</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Pliegos fotográficos analógicos / Polaroids -->
    {allMiradas.length > 0 && (
      <section id="miradas" class="home-section">
        <div class="home-section-header">
          <h2 class="home-section-title">Registros Analógicos &middot; Instantes Minerales</h2>
          <span class="home-section-more">{allMiradas.length} instantes</span>
        </div>

        <div class="plate-grid">
          {allMiradas.map((mirada) => (
            <article class="plate-card">
              <a href={`/posts/miradas-${mirada.id.replace(/\.md$/, '')}/`} class="plate-card">
                <figure class="plate-figure">
                  <img
                    src={mirada.data.photo.src}
                    alt={mirada.data.photo.alt}
                    class="plate-img"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="item-meta">
                  <span class="item-meta-category">{mirada.data.location || 'Registro'}</span>
                  {mirada.data.camera?.model && <span>&middot; {mirada.data.camera.model}</span>}
                </div>
                <h3 class="plate-title">{mirada.data.title || 'Instante mineral'}</h3>
                {mirada.data.footnote && (
                  <p class="plate-caption">{mirada.data.footnote}</p>
                )}
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
